@model Portal.Core.Models.Portal.PortalUploadContentModel

@{
    ViewBag.Title = "UploadContentImage";
    Layout = "~/Views/Shared/_Layout_empty.cshtml";
}

<h2>UploadContentImage</h2>

<script type="text/javascript">

    (function () {
        var errorMessage = @Json.Serialize(Model?.ErrorMessage);
        if (errorMessage) {
            top.alert(errorMessage);
            return;
        }

        top.$('.mapimage-preview').empty();
        var imageUrl = top.webgis.url.relative(@Json.Serialize(Model?.ImageUrl));
        top.$("<div>")
            .css({ background: "url('" + imageUrl + "') no-repeat center center", width: '140px', height: '140px' })
            .appendTo(top.$('.mapimage-preview'));
    })();

</script>
