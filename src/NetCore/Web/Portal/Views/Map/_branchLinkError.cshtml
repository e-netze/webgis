@model Portal.Core.Models.Map.BranchLinkErrorModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Branch-Link</title>

    <style>
        body {
            background: #808080;
            text-align: center;
            font-family: "Segoe UI", Verdana, Helvetica, Sans-Serif;
        }

        .error-message {
            max-width: 800px;
            text-align: left;
            margin: auto;
            background: #fff;
            border-radius: 5px;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
            overflow: hidden;
        }

            .error-message h1 {
                color: #80c826;
                background: #f8f8f8;
                padding: 20px;
                margin: 0px;
                font-weight: normal;
            }

            .error-message .message {
                padding: 20px;
                color: #ff0000;
            }

            .error-message .buttons {
                padding: 0px 20px 20px 20px;
            }

                .error-message .buttons a {
                    display: inline-block;
                    padding: 8px 16px;
                    background: #80c826;
                    color: #fff;
                    border-radius: 3px;
                    text-decoration: none;
                }
    </style>
</head>
<body>
    <div class="error-message">
        <h1>WebGIS CMS-Branch</h1>
        <div class="message">@Model.Message</div>
        <div class="buttons">
            <a href="@Model.MapUrl">Karte ohne Branch öffnen</a>
        </div>
    </div>
</body>
</html>