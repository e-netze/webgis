@model Cms.Models.CmsModel
@using E.Standard.Cms.Configuration
@using E.Standard.Cms.Configuration.Services
@using E.Standard.CMS.Core.Extensions
@inject CmsConfigurationService CCS
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory

@{
    ViewData["Title"] = "Home Page";

    var gitLocalizer = Model.IsGitEnabled ? LocalizerFactory.CreateCmsLocalizer(typeof(Cms.Controllers.GitController)) : null;
    var gitL10n = Model.IsGitEnabled
        ? Cms.Controllers.GitController.ClientL10nKeys.ToDictionary(k => k, k => gitLocalizer.Localize(k))
        : null;
}

@if (Model.IsGitEnabled && !Model.IsWorkspaceAvailable)
{
    <div class="cms-git-no-workspace">
        <h2>@gitL10n["workspace-missing-title"]</h2>
        <p>@gitL10n["workspace-missing-text"]</p>
        <button class="cms-git-button primary" onclick="CMSGit.initWorkspace();return false;">@gitL10n["init-workspace"]</button>
    </div>
}
else
{
    <div id="main-navbar">
    </div>
    <div id="main-navtree">
    </div>
    <div id="main-container" class="cms-main-container">
        <div id="main-toolbar">
        </div>
        <div id="main-content">
        </div>
    </div>
}

@section Scripts  {
    @if (Model.IsGitEnabled)
    {
        <link rel="stylesheet" href="~/css/site-cms-git.css?@(CmsGlobals.CssVersion)" />
        <script src="~/js/site-cms-git.js?@(CmsGlobals.JsVersion)"></script>
        <script type="text/javascript">
            CMSGit.l10n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(gitL10n));
        </script>
    }
    @if (Model.IsGitEnabled && !Model.IsWorkspaceAvailable)
    {
        <script type="text/javascript">
            CMS.id = '@Model.CmsId';
            CMSGit.init(false);
        </script>
    }
    else
    {
    <script src="~/js/site-cms.js"></script>
    <script type="text/javascript">

        CMS.id = '@Model.CmsId';
        CMS.init();
        @if (Model.IsGitEnabled)
        {
            @:CMSGit.init(true);
        }

        var hasElastic = @(CCS.HasElastic.ToString().ToLower());

        $('.navbar-search-button')
            .click(function () {
                $('.navbar-search-holder').toggleClass('collapsed');
                if ($('.navbar-search-holder').hasClass('collapsed')) {
                    $('.navbar-search-holder input').focus();
                }
            });

        $('.navbar-header .tool.order')
            .click(function() {
                let $tool = $(this);
                let $list = $(".cms-content").children("ul");

                if ($tool.hasClass("refresh")) {
                    CMS.updateContent(document.currentPath);
                    return;
                }
                CMS.sortAlphabetic(
                    $list,
                    $tool.hasClass("desc")
                );

                CMS.destroySortable($list);

                if ($tool.hasClass("desc")) $tool.removeClass("desc").addClass("asc");
                else if ($tool.hasClass("asc")) $tool.removeClass("asc").addClass("refresh");
            });

    </script>
    }
}

