@using E.Standard.Cms.Extensions
@model Cms.Models.DeployModel

@{
    ViewData["Title"] = "Deplay";
    Layout = Model.IsIFramed ? "~/Views/Shared/_Layout_empty.cshtml" : "~/Views/Shared/_Layout.cshtml";
}

<div class="padding:4px">
    <h3>@(Model.CmsItem.Name) Veröffentlichen</h3>

    @if (Model.GitDeployInfo != null && Model.GitLocalizer != null)
    {
        var git = Model.GitDeployInfo;
        var L = Model.GitLocalizer;
        Func<E.Standard.Cms.Git.Models.CmsGitCommitInfo, string> commitText = c =>
            c == null ? "" :
            c.ShortSha
            + (c.Date.HasValue ? " - " + c.Date.Value.LocalDateTime.ToShortDateString() + " " + c.Date.Value.LocalDateTime.ToShortTimeString() : "")
            + (String.IsNullOrEmpty(c.Author) ? "" : " - " + c.Author)
            + (String.IsNullOrEmpty(c.Message) ? "" : ": " + c.Message);

        <style>
            .cms-git-deploy-info { max-width: 900px; margin: 8px 0 16px 0; padding: 10px 12px; border: 1px solid #ddd; border-radius: 4px; background: #fafafa; }
            .cms-git-deploy-title { font-weight: bold; margin-bottom: 4px; }
            .cms-git-deploy-commit { font-family: monospace; margin: 2px 0 6px 0; word-break: break-word; }
            .cms-git-deploy-muted { color: #666; }
            .cms-git-deploy-warning { color: #8a5a00; background: #fff4d6; border-left: 3px solid #e0a000; padding: 4px 8px; margin: 6px 0; }
            .cms-git-deploy-warning ul { margin: 4px 0 0 0; padding-left: 20px; }
        </style>
        <div class="cms-git-deploy-info">
            <div class="cms-git-deploy-title">@L.Localize("deploy-git-title")</div>

            @if (Model.GitDeployRunningBy != null)
            {
                <div class="cms-git-deploy-warning">@String.Format(L.Localize("deploy-git-running"), Model.GitDeployRunningBy)</div>
            }

            @if (!String.IsNullOrEmpty(git.Error))
            {
                <div class="cms-git-deploy-warning">@L.Localize("deploy-git-remote-error") @git.Error</div>
            }

            @if (git.RemoteHead != null)
            {
                <div>@String.Format(L.Localize("deploy-git-source"), git.DefaultBranch)</div>
                <div class="cms-git-deploy-commit">@commitText(git.RemoteHead)</div>
            }
            else if (String.IsNullOrEmpty(git.Error))
            {
                <div class="cms-git-deploy-warning">@String.Format(L.Localize("deploy-git-no-remote-head"), git.DefaultBranch)</div>
            }

            @if (git.LastDeployed == null)
            {
                <div class="cms-git-deploy-muted">@L.Localize("deploy-git-never-deployed")</div>
            }
            else if (git.RemoteHead != null && git.LastDeployed.Sha == git.RemoteHead.Sha)
            {
                <div class="cms-git-deploy-muted">@L.Localize("deploy-git-already-deployed")</div>
            }
            else
            {
                <div class="cms-git-deploy-muted">@String.Format(L.Localize("deploy-git-last-deployed"), commitText(git.LastDeployed))</div>
            }

            @if (git.UserStatus == null || !git.UserStatus.HasWorkspace)
            {
                <div class="cms-git-deploy-muted">@L.Localize("deploy-git-no-workspace")</div>
            }
            else if (git.HasUnpublishedChanges)
            {
                var status = git.UserStatus;
                var changeCount = status.Changes?.Count() ?? 0;

                <div class="cms-git-deploy-warning">
                    @L.Localize("deploy-git-unpublished")
                    <ul>
                        @if (changeCount > 0)
                        {
                            <li>@String.Format(L.Localize("changes"), changeCount)</li>
                        }
                        @if (status.Ahead > 0)
                        {
                            <li>@String.Format(L.Localize("ahead"), status.Ahead)</li>
                        }
                        @if (!status.IsDefaultBranch)
                        {
                            <li>@String.Format(L.Localize("deploy-git-unpublished-branch"), status.Branch, git.DefaultBranch)</li>
                        }
                        else if (!status.HasUpstream)
                        {
                            <li>@L.Localize("no-upstream")</li>
                        }
                        @if (status.IsMerging)
                        {
                            <li>@L.Localize("deploy-git-unpublished-merging")</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

    @{
        var branchDeployEnabled = Model.GitLocalizer != null;
        var branchDeployments = branchDeployEnabled
            ? Model.CmsItem.Deployments.Where(d => d.AllowBranchDeploy).ToArray()
            : new E.Standard.Cms.Configuration.Models.CmsConfig.DeployItem[0];
    }

    @foreach (var deploy in Model.CmsItem.Deployments)
    {
        var fi = new System.IO.FileInfo(deploy.Target);
        var fiWargings = deploy.Target.WarningsFileInfo();

    <div style="display:inline-block">
        <div class="tile wide deploy" data-cmsid="@Model.CmsItem.Id" data-name="@deploy.Name" data-branch-deploy="@((branchDeployEnabled && deploy.AllowBranchDeploy).ToString().ToLower())">
            @if (branchDeployEnabled)
            {
                var allowsBranches = deploy.AllowBranchDeploy;
                <div class="deploy-scope @(allowsBranches ? "branches" : "main-only")"
                     title="@Model.GitLocalizer.Localize(allowsBranches ? "deploy-tile-branches-tooltip" : "deploy-tile-main-only-tooltip")">
                    @Model.GitLocalizer.Localize(allowsBranches ? "deploy-tile-branches" : "deploy-tile-main-only")
                </div>
            }
            @if (fi.Exists)
            {
                <div class="text">@deploy.Name<br />@(fi.LastWriteTime.ToShortDateString() + " " + fi.LastWriteTime.ToLongTimeString())</div>
            }
            else
            {
                <div class="text">@deploy.Name</div>
            }

        </div>
        @if(fiWargings.Exists) 
        { 
            <div class="tile wide warning" data-cmsid="@Model.CmsItem.Id" data-name="@deploy.Name">
                <div class="text">@deploy.Name<br/>Warnungen automatisch beheben/löschen</div>
            </div>
        }
        @if (branchDeployEnabled && deploy.AllowBranchDeploy)
        {
            var fiBranchWarnings = deploy.Target.BranchWarningsFileInfo(Model.Username);
            if (fiBranchWarnings.Exists)
            {
                <div class="tile wide warning" data-cmsid="@Model.CmsItem.Id" data-name="@deploy.Name" data-branch="true"
                     title="@Model.GitLocalizer.Localize("deploy-tile-branch-warnings-tooltip")">
                    <div class="text">@deploy.Name (@(fiBranchWarnings.BranchWarningsBranchName() ?? "branch"))<br />@Model.GitLocalizer.Localize("deploy-tile-branch-warnings")</div>
                </div>
            }
        }
    </div>
    }

    @if (branchDeployments.Length > 0)
    {
        var L = Model.GitLocalizer;

        <style>
            .cms-branch-deploys { max-width: 900px; margin: 16px 0; }
            .cms-branch-deploys-title { font-weight: bold; margin-bottom: 4px; }
            .cms-branch-deploys table { width: 100%; border-collapse: collapse; }
            .cms-branch-deploys th, .cms-branch-deploys td { padding: 3px 6px; border-bottom: 1px solid #ddd; text-align: left; vertical-align: middle; }
            .cms-branch-deploys td.commit { font-family: monospace; }
            .cms-branch-deploys .muted { color: #666; }
        </style>

        @foreach (var deploy in branchDeployments)
        {
            <div class="cms-branch-deploys" data-cmsid="@Model.CmsItem.Id" data-name="@deploy.Name">
                <div class="cms-branch-deploys-title">@String.Format(L.Localize("branch-deploys-title"), deploy.Name)</div>
                <div class="cms-branch-deploys-content muted">@L.Localize("branch-deploys-loading")</div>
            </div>
        }
    }
</div>


@section Scripts  {

    <script type="text/javascript">

        $(document).ready(function () {

            @{
                var GL = Model.GitLocalizer;
                var gitStatus = Model.GitDeployInfo?.UserStatus;
                var branchL10n = GL == null ? null : new Dictionary<string, string>()
                {
                    ["title"] = GL.Localize("deploy-choice-title"),
                    ["production"] = GL.Localize("deploy-choice-production"),
                    ["production-sub"] = String.Format(GL.Localize("deploy-choice-production-sub"), Model.GitDeployInfo?.DefaultBranch),
                    ["branch"] = GL.Localize("deploy-choice-branch"),
                    ["branch-sub"] = String.Format(GL.Localize("deploy-choice-branch-sub"), Model.GitBranchDeployName),
                    ["branch-merging"] = GL.Localize("deploy-choice-branch-merging"),
                    ["branch-uncommitted"] = GL.Localize("deploy-choice-branch-uncommitted"),
                    ["branch-not-possible"] = GL.Localize("deploy-choice-branch-not-possible"),
                    ["cancel"] = GL.Localize("deploy-choice-cancel"),
                    ["none"] = GL.Localize("branch-deploys-none"),
                    ["col-branch"] = GL.Localize("branch-deploys-branch"),
                    ["col-user"] = GL.Localize("branch-deploys-user"),
                    ["col-commit"] = GL.Localize("branch-deploys-commit"),
                    ["col-date"] = GL.Localize("branch-deploys-date"),
                    ["uncommitted"] = GL.Localize("branch-deploys-uncommitted"),
                    ["remove"] = GL.Localize("branch-deploys-remove"),
                    ["remove-confirm"] = GL.Localize("branch-deploys-remove-confirm"),
                    ["load-error"] = GL.Localize("branch-deploys-load-error"),
                    ["fast-info"] = GL.Localize("deploy-choice-fast-info"),
                    ["fast-full"] = GL.Localize("deploy-choice-fast-full")
                };
                var cacheInfo = Model.ExportCacheInfo;
                var branchState = new
                {
                    name = Model.GitBranchDeployName,
                    hasChanges = gitStatus?.Changes?.Any() == true,
                    isMerging = gitStatus?.IsMerging == true,
                    cacheDate = cacheInfo?.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
                    cacheCommit = cacheInfo?.Commit is string c && c.Length > 7 ? c.Substring(0, 7) : cacheInfo?.Commit
                };
            }
            var branchL10n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchL10n));
            var branchState = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchState));

            var esc = function (s) { return $('<div>').text(s === null || s === undefined ? '' : String(s)).html(); };
            var fmt = function (s) {
                var args = Array.prototype.slice.call(arguments, 1);
                return String(s).replace(/\{(\d+)\}/g, function (m, i) { return args[i] !== undefined ? args[i] : m; });
            };

            var deployProduction = function (cmsId, name) {
                CMS.openConsole(cmsId + '/deploy/' + encodeURIComponent(name), true);
            };
            var deployBranch = function (cmsId, name, full) {
                CMS.openConsole(cmsId + '/deploy/' + encodeURIComponent(name) + '?branch=true' + (full ? '&full=true' : ''), true);
            };

            $('.tile.deploy').click(function () {
                var cmsId = $(this).attr('data-cmsid'), name = $(this).attr('data-name');

                if ($(this).attr('data-branch-deploy') !== 'true' || !branchL10n) {
                    deployProduction(cmsId, name);
                    return;
                }

                var branchHint = !branchState.name ? branchL10n['branch-not-possible']
                    : branchState.isMerging ? branchL10n['branch-merging']
                    : null;
                var branchInfo = branchL10n['branch-sub'] + (branchState.hasChanges ? ' ' + branchL10n['branch-uncommitted'] : '');

                var $dialog = null;
                var buttons = {
                    cancel: { label: esc(branchL10n['cancel']), className: 'btn-default' },
                    production: {
                        label: esc(branchL10n['production']), className: 'btn-primary',
                        callback: function () { deployProduction(cmsId, name); }
                    }
                };
                if (!branchHint) {
                    buttons.branch = {
                        label: esc(branchL10n['branch']), className: 'btn-success',
                        callback: function () { deployBranch(cmsId, name, $dialog && $dialog.find('.cms-deploy-full').is(':checked')); }
                    };
                }

                // fast deploy: only offered, if a snapshot of the working copy exists
                var fastHtml = !branchHint && branchState.cacheDate
                    ? '<p class="cms-deploy-fast"><span class="muted">' + esc(fmt(branchL10n['fast-info'], branchState.cacheDate, branchState.cacheCommit || '')) + '</span><br/>' +
                      '<label><input type="checkbox" class="cms-deploy-full" /> ' + esc(branchL10n['fast-full']) + '</label></p>'
                    : '';

                $dialog = bootbox.dialog({
                    title: esc(fmt(branchL10n['title'], name)),
                    message:
                        '<p><strong>' + esc(branchL10n['production']) + '</strong><br/><span class="muted">' + esc(branchL10n['production-sub']) + '</span></p>' +
                        '<p><strong>' + esc(branchL10n['branch']) + '</strong><br/><span class="muted">' + esc(branchHint || branchInfo) + '</span></p>' +
                        fastHtml,
                    buttons: buttons
                });
            });

            var loadBranchDeploys = function ($container) {
                var cmsId = $container.attr('data-cmsid'), name = $container.attr('data-name');
                var $content = $container.find('.cms-branch-deploys-content');

                $.ajax({
                    url: CMS.appRootUrl + '/deploy/branchdeploys/' + encodeURIComponent(cmsId) + '?name=' + encodeURIComponent(name),
                    type: 'get',
                    success: function (result) {
                        $content.empty().removeClass('muted');
                        if (!result || result.success === false) {
                            $content.addClass('muted').text(branchL10n['load-error'] + ' ' + ((result && result.exception) || ''));
                            return;
                        }
                        if (!result.deploys || result.deploys.length === 0) {
                            $content.addClass('muted').text(branchL10n['none']);
                            return;
                        }

                        var $table = $('<table>').appendTo($content);
                        $('<tr>')
                            .append($('<th>').text(branchL10n['col-branch']))
                            .append($('<th>').text(branchL10n['col-user']))
                            .append($('<th>').text(branchL10n['col-commit']))
                            .append($('<th>').text(branchL10n['col-date']))
                            .append($('<th>'))
                            .appendTo($table);

                        $.each(result.deploys, function (i, d) {
                            var date = d.date ? new Date(d.date) : null;
                            $('<tr>')
                                .append($('<td>').text(d.branch || d.encoded_branch))
                                .append($('<td>').text(d.user || ''))
                                .append($('<td class="commit">').text((d.commit || '').substring(0, 7) + (d.uncommitted ? ' ' + branchL10n['uncommitted'] : '')).attr('title', d.commit || ''))
                                .append($('<td>').text(date ? date.toLocaleString() : ''))
                                .append($('<td>').append(
                                    $('<button type="button" class="btn btn-default btn-xs">').text(branchL10n['remove']).click(function () {
                                        CMS.confirm(esc(fmt(branchL10n['remove-confirm'], d.branch || d.encoded_branch)), function () {
                                            $.ajax({
                                                url: CMS.appRootUrl + '/deploy/removebranchdeploy/' + encodeURIComponent(cmsId),
                                                type: 'post',
                                                data: { name: name, branch: d.encoded_branch },
                                                success: function (r) {
                                                    if (r && r.success === false) {
                                                        CMS.alert(r.exception);
                                                    }
                                                    loadBranchDeploys($container);
                                                },
                                                error: function () { CMS.alert(); }
                                            });
                                        });
                                    })))
                                .appendTo($table);
                        });
                    },
                    error: function () {
                        $content.addClass('muted').text(branchL10n['load-error']);
                    }
                });
            };

            $('.cms-branch-deploys').each(function () {
                loadBranchDeploys($(this));
            });
            $('.tile.warning').click(function () {
                CMS.openConsole($(this).attr('data-cmsid') + '/solvewarnings/' + encodeURI($(this).attr('data-name')) + ($(this).attr('data-branch') === 'true' ? '?branch=true' : ''), true);
            });
        });

    </script>

}