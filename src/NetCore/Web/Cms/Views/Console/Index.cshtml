@model ConsoleModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Empty.cshtml";
}


<div class="console-pane running">
    <div class="console-status"></div>
    <div class="console-output">
        <div class="console-line muted"><span class="txt">Prompt:&gt;</span></div>
    </div>
    <button id="btnCancel">Cancel</button>
</div>

@section Scripts  {

    <script type="text/javascript">

        var procId = '@Model.ProcId';

        function consoleLine(line, cssClass) {
            var $line = $("<div>").addClass('console-line');
            var m = /^(?:>|&gt;)(\d+):\s?/.exec(line);
            if (m) {
                $("<span>").addClass('ln').text(m[1]).appendTo($line);
                line = line.substring(m[0].length);
            }
            var $text = $("<span>").addClass('txt').html(line).appendTo($line);

            if (!cssClass) {
                var text = $text.text();
                if (/^[=\-]{10,}$/.test(text.trim())) cssClass = 'separator';
                else if (/^(upload )?succeeded\b/i.test(text)) cssClass = 'success';
                else if (/^(canceled\b|try to cancel process$)/i.test(text)) cssClass = 'canceled';
                else if (/^(critical\b|error\b|exception:|stacktrace:)/i.test(text)) cssClass = 'error';
                else if (/^warning\b/i.test(text)) cssClass = 'warning';
                else if (/^(scann for warnings|export( \(incl\. link check\))?|replace\.\.\.|release cache)$/i.test(text.trim())) cssClass = 'step';
                else if (/^(environment|branch|commit):/i.test(text)) cssClass = 'meta';
                else if (/^(scanned|processed|loaded) \d+/i.test(text) || /^\s+(\{\{|->)/.test(text)) cssClass = 'muted';
                else if (/^(exported \d+ nodes|replaced in|written\/uploaded in) /i.test(text)) cssClass = 'meta';
            }
            return $line.addClass(cssClass || '');
        }

        function finished(state) {
            $('#btnCancel').css('display', 'none');
            $('.console-pane').removeClass('running').addClass(state || 'done');
            window.parent.CMS.consoleFinished();
        };

        $(document).ready(function () {

            $('#btnCancel').click(function () {
                $(this).prop('disabled', true);
                $.ajax({
                    url: 'Console/Cancel?procId=' + procId,
                    type: 'get',
                    success: function(result) {
                    }
                });
            });

            function ping() {
                clearInterval(timer);
                $.ajax({
                    url: 'Console/Ping?procId=' + procId,
                    type: 'get',
                    success: function(result) {
                        var d = $('.console-output');
                        if (result.success == true) {
                            if (result.lines == null) {
                                d.append($("<div>END</div>").addClass('console-line end'));
                                d.scrollTop(d.prop("scrollHeight"));
                                finished(d.find('.console-line.success').length > 0
                                    ? 'done'
                                    : d.find('.console-line.canceled').length > 0 ? 'canceled'
                                    : d.find('.console-line.error').length > 0 ? 'failed' : 'done');

                                if (result.hasfile === true) {
                                    CMS.downloadFile('Console/DownloadFile?procId=' + procId);
                                }
                            } else {
                                for (var i = 0; i < result.lines.length; i++) {
                                    d.append(consoleLine(result.lines[i]));
                                }

                                d.animate({ scrollTop: d.prop("scrollHeight")-$(window).height() }, 1000);
                                timer = setInterval(ping, 1000);
                            }
                        } else {
                            d.append(consoleLine("ERROR: " + result.message, 'error'));
                            d.scrollTop(d.prop("scrollHeight"));
                            finished('failed');

                        }
                    },
                    error: function() {
                        var d = $('.console-output');
                        timer = setInterval(ping, 1000);
                        d.append(consoleLine("Connection error...", 'error'));
                        d.scrollTop(d.prop("scrollHeight"));
                    }
                });
            }

            var timer=setInterval(ping, 1000);
        });

    </script>

}



