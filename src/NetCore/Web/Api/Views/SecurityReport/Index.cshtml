@using Api.Core.AppCode.Services.Security
@model SecurityReport
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory

@{
    var L = LocalizerFactory.Create(typeof(object));
    string T(string key) => L[$"pages.security-report.{key}"].Value;
    ViewBag.Title = T("title");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string docsBase = T("docs-url");

    string Css(SecurityStatus s) => s.ToString().ToLower();
    string Icon(SecurityStatus s) => s switch
    {
        SecurityStatus.Ok => "✔",
        SecurityStatus.Warning => "▲",
        SecurityStatus.Critical => "✖",
        SecurityStatus.Hint => "ℹ",
        _ => "–"
    };
    string StatusText(SecurityStatus s) => s switch
    {
        SecurityStatus.Ok => T("status-ok"),
        SecurityStatus.Warning => T("status-warning"),
        SecurityStatus.Critical => T("status-critical"),
        SecurityStatus.Hint => T("status-hint"),
        _ => T("status-na")
    };
    string CategoryText(SecurityCategory c) => c switch
    {
        SecurityCategory.CompatibilityOptOut => T("category-optout"),
        SecurityCategory.FeatureEnablement => T("category-feature"),
        _ => T("category-tuning")
    };
    string RiskText(object r) => r.ToString() switch { "High" => T("risk-high"), "Medium" => T("risk-medium"), "Low" => T("risk-low"), _ => T("risk-info") };
    var statuses = new[] { SecurityStatus.Critical, SecurityStatus.Warning, SecurityStatus.Hint, SecurityStatus.Ok, SecurityStatus.NotApplicable };
}

<div class="webgis-page wide security-report">
    <div class="webgis-page-page-title">
        <h2>@T("title")</h2>
    </div>

    <div class="webgis-page-alert info">
        <span>
            @T("intro")
            <a href="@($"{docsBase}#annex-security-keys")" target="_blank" rel="noopener">@T("docs-link")</a>
        </span>
    </div>

    @if (!Model.LoginEnabled)
    {
        <div class="webgis-page-alert info" role="status">@T("login-disabled")</div>
    }
    @if (!Model.HasEndpointCredentials)
    {
        <div class="webgis-page-alert warning" role="alert">@T("no-credentials")</div>
    }

    <div class="sr-cards">
        @foreach (var internet in new[] { true, false })
        {
            <div class="webgis-page-card sr-card">
                <div class="webgis-page-card-body">
                    <h3>@T(internet ? "internet" : "intranet")</h3>
                    @foreach (var s in statuses)
                    {
                        var n = Model.Count(internet, s);
                        if (n > 0)
                        {
                            <span class="sr-badge sr-@Css(s)">@Icon(s) @n &nbsp;@StatusText(s)</span>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <div class="webgis-page-card">
        <div class="webgis-page-card-header webgis-page-header-row">
            <h3>@T("settings")</h3>
            <label class="sr-filter">
                <input type="checkbox" id="sr-only-findings" /> @T("only-findings")
            </label>
        </div>
        <div class="sr-scroll">
            <table class="webgis-page-table sr-table">
                <thead>
                    <tr>
                        <th>@T("col-key")</th>
                        <th>@T("col-value")</th>
                        <th>@T("col-default")</th>
                        <th>@T("col-category")</th>
                        <th>@T("col-risk")</th>
                        <th>@T("internet")</th>
                        <th>@T("intranet")</th>
                        <th>@T("col-docs")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var rule = row.Rule;
                        var finding = row.Internet is SecurityStatus.Critical or SecurityStatus.Warning
                                      || row.Intranet is SecurityStatus.Critical or SecurityStatus.Warning;
                        <tr data-finding="@(finding ? "1" : "0")">
                            <td><code>@rule.Key</code></td>
                            <td>
                                @if (rule.Secret)
                                {
                                    @T(row.IsSet ? "set" : "not-set")
                                }
                                else if (row.IsSet)
                                {
                                    @row.Value
                                }
                                else
                                {
                                    <i>@T("default")</i>
                                }
                            </td>
                            <td>@rule.DefaultValue</td>
                            <td><span class="sr-pill">@CategoryText(rule.Category)</span></td>
                            <td><span class="sr-pill sr-risk-@rule.Risk.ToString().ToLower()">@RiskText(rule.Risk)</span></td>
                            <td><span class="sr-badge sr-@Css(row.Internet)">@Icon(row.Internet) @StatusText(row.Internet)</span></td>
                            <td><span class="sr-badge sr-@Css(row.Intranet)">@Icon(row.Intranet) @StatusText(row.Intranet)</span></td>
                            <td><a href="@($"{docsBase}#{rule.AnnexAnchor}")" target="_blank" rel="noopener">@T("annex")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.SubscribersError)
    {
        <h3 class="webgis-page-section-title">@T("subscribers")</h3>
        <div class="webgis-page-alert warning" role="alert">@T("subscribers-error")</div>
    }
    else if (Model.Subscribers != null)
    {
        var withMfa = Model.Subscribers.Count(s => s.Mfa == SubscriberMfaState.Enabled);
        <div class="webgis-page-card">
            <div class="webgis-page-card-header">
                <h3>@T("subscribers")</h3>
                <div class="webgis-page-subtitle">@T("subscribers-summary").Replace("{0}", Model.Subscribers.Count.ToString()).Replace("{1}", withMfa.ToString())</div>
            </div>
            <div class="sr-scroll">
                <table class="webgis-page-table sr-table">
                    <thead>
                        <tr>
                            <th>@T("col-user")</th>
                            <th>@T("col-role")</th>
                            <th>@T("col-mfa")</th>
                            <th>@T("col-mfa-required")</th>
                            <th>@T("col-recovery")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Subscribers)
                        {
                            var mfaCss = s.Mfa switch
                            {
                                SubscriberMfaState.Enabled => "ok",
                                SubscriberMfaState.NotEnabled => s.IsAdmin ? "critical" : "warning",
                                _ => "notapplicable"
                            };
                            var mfaText = s.Mfa switch
                            {
                                SubscriberMfaState.Enabled => "✔ " + T("mfa-enabled"),
                                SubscriberMfaState.NotEnabled => "✖ " + T("mfa-disabled"),
                                _ => "– " + T("mfa-na")
                            };
                            <tr>
                                <td>@s.Name</td>
                                <td>@T(s.IsAdmin ? "role-admin" : "role-subscriber")</td>
                                <td><span class="sr-badge sr-@mfaCss">@mfaText</span></td>
                                <td>@T(s.MfaRequired ? "yes" : "no")</td>
                                <td>@(s.Mfa == SubscriberMfaState.Enabled ? s.RecoveryCodesLeft.ToString() : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script>
    document.getElementById('sr-only-findings').addEventListener('change', function () {
        var only = this.checked;
        document.querySelectorAll('.sr-table tbody tr[data-finding]').forEach(function (tr) {
            tr.style.display = (only && tr.dataset.finding !== '1') ? 'none' : '';
        });
    });
</script>