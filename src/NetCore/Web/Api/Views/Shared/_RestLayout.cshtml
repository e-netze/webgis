<!DOCTYPE html>
<html style="background:white">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="IE=9,10,edge" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <title>@ViewBag.Title</title>

    <environment names="Development">
        <link href="~/content/Site.css" rel="stylesheet" />
    </environment>

    <environment names="Staging,Production">
        <link href="~/content/Site.css" rel="stylesheet" />
    </environment>
    <link href="~/content/site.overrides.css" rel="stylesheet" />
    <style>:root { @Html.Raw(StyleService.GetBrandVariablesFromEnvironment()) }</style>

    @* <link href="~/content/styles/default.css" rel="stylesheet" /> *@

    <script src="~/scripts/jquery-3.4.1.min.js"></script>
    <link href="~/lib/webportal-layout/webportal-layout.css" rel="stylesheet" />
    <script src="~/lib/webportal-layout/webportal-layout.js"></script>

    <style>
        .rest-autocomplete-menu { display: none; position: absolute; z-index: 1000; box-sizing: border-box; max-height: 300px; overflow-y: auto; background: #fff; border: 1px solid #ccc; box-shadow: 0 2px 6px rgba(0,0,0,.2); text-align: left; }
        .rest-autocomplete-item, .rest-autocomplete-empty { padding: 4px 8px; cursor: pointer; }
        .rest-autocomplete-empty { color: #888; cursor: default; }
        .rest-autocomplete-item:hover, .rest-autocomplete-item.cursor { background: #e8f0fe; }
        .rest-autocomplete-subtext { color: #888; font-size: 0.8em; }
    </style>
    <script type="text/javascript">
        function moveDown(dir) {
            document.location += '/' + dir;
        }
        function toJsonView() {
            document.location += '?f=pjson';
        }

        // autocomplete test inputs (HtmlHelper.Autocomplete): simple suggestion menu below the input
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('input.webgis-autocomplete').forEach(function (input) {
                var menu = document.createElement('div');
                menu.className = 'rest-autocomplete-menu';
                document.body.appendChild(menu);
                input.setAttribute('autocomplete', 'off');

                var timer = null, controller = null, cursor = -1;

                var options = function () { return menu.querySelectorAll('.rest-autocomplete-item'); };
                var close = function () { menu.style.display = 'none'; cursor = -1; };
                var open = function () {
                    var rect = input.getBoundingClientRect();
                    menu.style.left = (rect.left + window.scrollX) + 'px';
                    menu.style.top = (rect.bottom + window.scrollY) + 'px';
                    menu.style.width = rect.width + 'px';
                    menu.style.display = 'block';
                };
                var select = function (item) {
                    input.value = item.dataset.value;
                    close();
                };
                var setCursor = function (index) {
                    var items = options();
                    if (items.length === 0) {
                        return;
                    }
                    cursor = (index + items.length) % items.length;
                    items.forEach(function (item, i) { item.classList.toggle('cursor', i === cursor); });
                    items[cursor].scrollIntoView({ block: 'nearest' });
                };

                var query = function () {
                    var url = input.getAttribute('data-source');
                    var scope = input.closest('form') || input.parentElement;
                    scope.querySelectorAll('.webgis-input,.webgis-autocomplete-parameter').forEach(function (h) {
                        url += '&' + (h.name || h.id) + '=' + encodeURIComponent(h.value);
                    });
                    if (input.getAttribute('data-search-categories')) {
                        url += '&categories=' + encodeURIComponent(input.getAttribute('data-search-categories'));
                    }

                    if (controller) {
                        controller.abort();
                    }
                    controller = new AbortController();

                    fetch(url, { signal: controller.signal })
                        .then(function (response) { return response.json(); })
                        .then(function (items) {
                            menu.replaceChildren();
                            cursor = -1;
                            (items || []).slice(0, 12).forEach(function (item) {
                                var div = document.createElement('div');
                                div.className = 'rest-autocomplete-item';
                                div.dataset.value = typeof item === 'string' ? item : (item.label || item.value || '');
                                div.textContent = div.dataset.value;
                                if (typeof item !== 'string' && item.subtext) {
                                    var sub = document.createElement('div');
                                    sub.className = 'rest-autocomplete-subtext';
                                    sub.textContent = item.subtext;
                                    div.appendChild(sub);
                                }
                                menu.appendChild(div);
                            });
                            if (menu.children.length === 0) {
                                var empty = document.createElement('div');
                                empty.className = 'rest-autocomplete-empty';
                                empty.textContent = 'Keine Ergebnisse gefunden';
                                menu.appendChild(empty);
                            }
                            open();
                        })
                        .catch(function () { });
                };

                input.addEventListener('input', function () {
                    clearTimeout(timer);
                    if (!input.value) {
                        close();
                        return;
                    }
                    timer = setTimeout(query, 250);
                });
                input.addEventListener('keydown', function (e) {
                    if (menu.style.display !== 'block') {
                        return;
                    }
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        setCursor(cursor + 1);
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        setCursor(cursor - 1);
                    } else if (e.key === 'Enter' && cursor >= 0) {
                        e.preventDefault();
                        select(options()[cursor]);
                    } else if (e.key === 'Escape') {
                        close();
                    }
                });
                input.addEventListener('blur', close);
                // mousedown instead of click: fires before the input's blur closes the menu
                menu.addEventListener('mousedown', function (e) {
                    var item = e.target.closest('.rest-autocomplete-item');
                    if (item) {
                        e.preventDefault();
                        select(item);
                    }
                });
                window.addEventListener('resize', close);
            });
        });
    </script>
</head>

<body style="background-color:#fff">
    @*<header>
            <div class="content-wrapper" style="background-color:#6cbe1a;">
                <div class="">
                    <p class="site-title">
                        <a href="~/">webGIS Api</a>
                        <br/>
