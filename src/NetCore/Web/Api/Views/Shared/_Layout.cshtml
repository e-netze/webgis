@using E.Standard.Api.App.Extensions
@inject E.Standard.Configuration.Services.ConfigurationService config 
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@inject E.Standard.Localization.Abstractions.ICultureProvider CultureProvider
@inject Microsoft.Extensions.Options.IOptions<E.Standard.Localization.Services.MarkdownLocalizerOptions> LocalizerOptions
@{
    var L = LocalizerFactory.Create(typeof(object));
    string activeLanguage = CultureProvider.Culture?.ToLowerInvariant();
    bool showLanguageSwitch = ViewData["page-has-language-switch"] as bool? != true;

    string LanguageUrl(string language)
    {
        var query = Context.Request.Query
            .Where(q => !q.Key.Equals("_ul", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string>(q.Key, v)))
            .Append(new KeyValuePair<string, string>("_ul", language));

        return Context.Request.PathBase + Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(query);
    }
}
<!DOCTYPE html>
<html style="background-color:#fff" lang="@activeLanguage">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="IE=9,10,edge" />

    <title>@ViewBag.Title</title>
    
    <link href="~/content/Site.css" rel="stylesheet" />
    <link href="~/content/api-pages.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("styles", required: false)
    <link href="~/content/site.overrides.css" rel="stylesheet" />

    <style>:root { @Html.Raw(StyleService.GetBrandVariablesFromEnvironment()) }</style>

    <script type="text/javascript">
        function moveDown(dir) {
            document.location += '/' + dir;
        }
        function toJsonView() {
            document.location += '?f=json';
        }
    </script>

</head>
<body>
    <nav class="webportal-layout-header navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container webgis-page-header">
            <div class="navbar-brand">WebGIS API</div>
            @if (showLanguageSwitch && LocalizerOptions.Value.SupportedLanguages.Length > 1)
            {
                <nav class="webgis-page-lang" aria-label="@L["pages.layout.language"]">
                    @foreach (var language in LocalizerOptions.Value.SupportedLanguages)
                    {
                        <a href="@LanguageUrl(language)" class="@(activeLanguage == language ? "active" : "")" lang="@language">@language.ToUpperInvariant()</a>
                    }
                </nav>
            }
        </div>
    </nav>

    <script src="~/scripts/jquery-3.4.1.min.js"></script>
    <script src="~/scripts/site.js"></script>
    <script src="~/scripts/api/ui/webgis_wizard.js" asp-append-version="true"></script>
    <link href="~/lib/webportal-layout/webportal-layout.css" rel="stylesheet" />
    <script src="~/lib/webportal-layout/webportal-layout.js"></script>

    <div class="webportal-layout-container page-has-header page-has-footer">
        <div class="webportal-layout-sidebar">
            <ul class="webportal-layout-sidebar-items top">
                <li class="webportal-layout-sidebar-item">
                    <img src="~/content/sidebar/portal-26-w.png" />
                    <a href="" onclick="goHome(); return false;">@L["pages.layout.home"]</a>
                </li>
                <li class="webportal-layout-sidebar-item hr">
                    <hr />
                    <div class="text"></div>
                </li>
            </ul>
            <ul class="webportal-layout-sidebar-items center">
            </ul>
            <ul class="webportal-layout-sidebar-items bottom">
                <li class="webportal-layout-sidebar-item hr">
                    <hr />
                    <div class="text">@((string)ViewData["append-subscriber-username"] ?? (string)ViewData["append-rest-username"])</div>
                </li>
                @if (String.IsNullOrWhiteSpace((string)ViewData["append-rest-username"]) && String.IsNullOrWhiteSpace((string)ViewData["append-subscriber-username"]))
                {
                   if (config.AllowSubscriberLogin() == true) 
                   {
                      <li class="webportal-layout-sidebar-item login">
                            <img src = "~/content/sidebar/login-26-w.png" />
                            <a asp-area="" asp-controller="Subscribers" asp-action="Login" asp-route-id="">@L["pages.layout.login"]</a>
                      </li>
                    }
                }
                else
                {
                    @if (!String.IsNullOrWhiteSpace((string)ViewData["append-subscriber-username"]))
                    {
                        <li class="webportal-layout-sidebar-item logout">
                            <img src="~/content/sidebar/logout-26-w.png" />
                            <a href="" onclick="subscriberLogOff();return false">@L["pages.layout.logout"]</a>
                        </li>
                    }
                    @if (!String.IsNullOrWhiteSpace((string)ViewData["append-rest-username"]))
                    {
                        <li class="webportal-layout-sidebar-item logout">
                            <img src="~/content/sidebar/logout-26-w.png" />
                            <a asp-area="" asp-controller="Rest" asp-action="Logout" asp-route-id="">@L["pages.layout.logout"]</a>
                        </li>
                    }
                }
            </ul>
        </div>
        <div class="webportal-layout-main">
            <div class="webportal-layout-main-container">
                @RenderBody()
            </div>
        </div>
    </div>

    <div class="webportal-layout-footer">
        <div class="version">
            <span><strong>Version:</strong> @E.Standard.Platform.WebGISVersion.Version</span>
        </div>
    </div>

    @RenderSection("scripts", required: false)


    <script type="text/javascript">

        (function () {
            // remember the language chosen with ?_ul=.. (language switch) for the following pages
            var match = /[?&]_ul=([a-zA-Z]{2})(&|$)/.exec(window.location.search);
            if (match) {
                document.cookie = '@(Api.Core.AppCode.Services.CultureProvider.CultureCookieName)=' + match[1].toLowerCase() +
                    ';path=@Url.Content("~/");max-age=31536000;samesite=lax';
            }
        })();

        $(document).ready(function () {
            $('.webgis-wizard').webgis_wizard();
        });

        function setLocation(url) {
            if (window.parent && window.parent.location) {
                window.parent.location.href = url;
            } else {
                window.location.href = url;
            }
        }

        function goHome() {
            var url = (window.parent && window.parent.homeUrl) ?
                window.parent.homeUrl :
                '@Url.Action("Index", "Home")';

            window.location.href = url;
        }

        function subscriberLogOff() {
            var url = '@Url.Action("Logout","Subscribers")';
            setLocation(url);
        }

    </script>

</body>
</html>
