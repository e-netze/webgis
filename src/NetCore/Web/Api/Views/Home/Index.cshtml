@using E.Standard.Api.App.Extensions
@inject E.Standard.Configuration.Services.ConfigurationService config
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@inject E.Standard.Localization.Abstractions.ICultureProvider CultureProvider

@{
    var L = LocalizerFactory.Create(typeof(object));
    ViewBag.Title = L["pages.home.title"].Value;
    string subscriberName = (string)ViewData["append-subscriber-username"];
    string docsLanguage = CultureProvider.Culture?.ToLowerInvariant() == "de" ? "de" : "en";
}

<script src="~/scripts/api/webgis-api.min.js" id="webgis-api-script"></script>

<div class="webgis-page">
    <div class="webgis-page-page-title">
        <h2>@L["pages.home.title"]</h2>
        <p class="webgis-page-intro">@L["pages.home.intro"]</p>
    </div>

    <div class="webgis-page-tiles">
        @if (config.AllowSubscriberLogin() && config.AppRoles().IsAllowed(E.Standard.Api.App.AppRoles.SubscriberPages))
        {
            <a class="webgis-page-tile" href="@Url.Action("index", "subscribers")">
                <img src="~/content/api/img/user-100.png" alt="" />
                <span>
                    <span class="webgis-page-tile-title">@(!String.IsNullOrWhiteSpace(subscriberName) ? subscriberName : L["pages.home.subscriber-title"].Value)</span>
                    <span class="webgis-page-tile-description">@L["pages.home.subscriber-description"]</span>
                </span>
            </a>
        }

        @if (config.AppRoles().IsAllowed(E.Standard.Api.App.AppRoles.WebgisApi))
        {
            <a class="webgis-page-tile" href="@Url.Action("index", "rest")">
                <img src="~/content/api/img/code-100.png" alt="" />
                <span>
                    <span class="webgis-page-tile-title">@L["pages.home.rest-title"]</span>
                    <span class="webgis-page-tile-description">@L["pages.home.rest-description"]</span>
                </span>
            </a>
        }

        <a class="webgis-page-tile" href="https://docs.webgiscloud.com/@(docsLanguage)/dev/API/API_JavaScript/index.html" target="_blank" rel="noopener">
            <img src="~/content/api/img/doc-100.png" alt="" />
            <span>
                <span class="webgis-page-tile-title">@L["pages.home.jsapi-title"]</span>
                <span class="webgis-page-tile-description">@L["pages.home.jsapi-description"]</span>
            </span>
        </a>
    </div>
</div>