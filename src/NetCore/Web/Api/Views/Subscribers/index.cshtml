@using E.Standard.Api.App.Extensions
@using E.Standard.Security.Cryptography.Services
@using E.Standard.WebApp.Options
@using E.Standard.WebGIS.Api.Abstractions
@using Microsoft.Extensions.Options

@model E.Standard.WebGIS.SubscriberDatabase.SubscriberDb.Subscriber
@inject E.Standard.Configuration.Services.ConfigurationService config
@inject IUrlHelperService UrlHelper
@inject JwtAccessTokenService TokenService
@inject IOptions<SecurityOptions> SecurityOptions
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory

@{
    var L = LocalizerFactory.Create(typeof(object));
    ViewBag.Title = L["pages.subscriber.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool mfaAvailable = ViewData["mfa-available"] as bool? == true;
    bool mfaEnabled = ViewData["mfa-enabled"] as bool? == true;
    bool mfaRequired = ViewData["mfa-required"] as bool? == true;
    bool isAdmin = config.IsAdminSubscriber(Model?.Name);

    string AdminToken() => TokenService.GenerateToken(SecurityOptions.Value.EndpointAuthorizationBearerUsername, 10);
    string portalUrl = UrlHelper.PortalUrl();

    void Tile(string href, string image, string titleKey, string descriptionKey)
    {
        <a class="webgis-page-tile" href="@href">
            <img src="@Url.Content($"~/content/api/img/{image}")" alt="" />
            <span>
                <span class="webgis-page-tile-title">@L[$"pages.subscriber.{titleKey}"]</span>
                <span class="webgis-page-tile-description">@L[$"pages.subscriber.{descriptionKey}"]</span>
            </span>
        </a>
    }
}

<div class="webgis-page">
    <div class="webgis-page-page-title">
        <h2>@(Model != null ? L["pages.subscriber.greeting"].Value.Replace("{0}", Model.FirstName ?? Model.Name) : ViewBag.Title)</h2>
    </div>

    @if (Model != null)
    {
        if (!mfaAvailable && (mfaRequired || isAdmin))
        {
            <div class="webgis-page-alert warning" role="alert">@L["subscribers.mfa.not-available"]</div>
        }
        else if (mfaAvailable && !mfaEnabled)
        {
            <div class="webgis-page-alert warning" role="alert">@L[mfaRequired ? "subscribers.mfa.required-hint" : "subscribers.mfa.recommended"]</div>
        }

        <h3 class="webgis-page-section-title">@L["subscribers.account.title"]</h3>
        <div class="webgis-page-tiles">
            <a class="webgis-page-tile" href="@Url.Action("account")">
                <img src="~/content/api/img/user-100.png" alt="" />
                <span>
                    <span class="webgis-page-tile-title">@L["subscribers.account.title"]</span>
                    <span class="webgis-page-tile-description">
                        @L["subscribers.account.tile-description"]<br />
                        @L["subscribers.mfa.title"]: @L[mfaEnabled ? "subscribers.mfa.status-enabled" : "subscribers.mfa.status-disabled"]
                    </span>
                </span>
            </a>
        </div>
    }

    @if (isAdmin)
    {
        <h3 class="webgis-page-section-title">@L["pages.subscriber.section-admin"]</h3>
        <div class="webgis-page-tiles">
            @{ Tile(Url.Action("adminsubscribers"), "admin-100.png", "admin-subscribers-title", "admin-subscribers-description"); }
        </div>

        <h3 class="webgis-page-section-title">@L["pages.subscriber.section-database"]</h3>
        <div class="webgis-page-tiles">
            @{ Tile(Url.Action("index", "setup", new { token = AdminToken() }), "admin-100.png", "setup-title", "setup-description"); }
            @{ Tile(Url.Action("migrate", "setup", new { token = AdminToken() }), "admin-100.png", "migrate-title", "migrate-description"); }
        </div>

        <h3 class="webgis-page-section-title">@L["pages.subscriber.section-api-cache"]</h3>
        <div class="webgis-page-tiles">
            @{ Tile(Url.Action("clear", "cache", new { token = AdminToken() }), "admin-100.png", "cache-clear-title", "api-cache-clear-description"); }
            @{ Tile(Url.Action("collect", "cache", new { token = AdminToken() }), "admin-100.png", "gc-title", "gc-description"); }
        </div>
        <h3 class="webgis-page-section-title">@L["pages.subscriber.section-security"]</h3>
        <div class="webgis-page-tiles">
            @{ Tile(Url.Action("index", "securityreport", new { token = AdminToken() }), "admin-100.png", "security-report-title", "security-report-description"); }
        </div>

        <h3 class="webgis-page-section-title">@L["pages.subscriber.section-portal-cache"]</h3>
        <div class="webgis-page-tiles">
            @{ Tile($"{portalUrl}/cache/clear?token={AdminToken()}", "admin-100.png", "cache-clear-title", "portal-cache-clear-description"); }
            @{ Tile($"{portalUrl}/cache/collect?token={AdminToken()}", "admin-100.png", "gc-title", "gc-description"); }
        </div>

        <h3 class="webgis-page-section-title">@L["pages.subscriber.section-portal-diagnostics"]</h3>
        <div class="webgis-page-tiles">
            @{ Tile($"{portalUrl}/cache/list?token={AdminToken()}", "admin-100.png", "usercache-title", "usercache-description"); }
            @{ Tile($"{portalUrl}/hmac?token={AdminToken()}", "admin-100.png", "userkeys-title", "userkeys-description"); }
            @{ Tile($"{portalUrl}/instance/info?f=pjson&token={AdminToken()}", "admin-100.png", "instance-info-title", "instance-info-description"); }
        </div>
    }
    else if (config.SubscriberToolClientsAvailable() || config.SubscriberToolPortalsAvailable())
    {
        <h3 class="webgis-page-section-title">@L["pages.subscriber.section-tools"]</h3>
        <div class="webgis-page-tiles">
            @if (config.SubscriberToolClientsAvailable())
            {
                Tile(Url.Action("clients"), "api-100.png", "clients-title", "clients-description");
            }
            @if (config.SubscriberToolPortalsAvailable())
            {
                Tile(Url.Action("portalpages"), "portal-100.png", "portals-title", "portals-description");
            }
        </div>
    }
</div>