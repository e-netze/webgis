@model E.Standard.Api.App.Models.ApiSubscribersLoginChangePassword

@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@inject Microsoft.Extensions.Options.IOptions<E.Standard.Api.App.Configuration.SubscriberSecurityOptions> SecurityOptions

@{
    var L = LocalizerFactory.Create(typeof(object));
    string uiLanguage = Context.Request.Query["_ul"].FirstOrDefault()
                        ?? (Context.Request.HasFormContentType ? Context.Request.Form["_ul"].FirstOrDefault() : null);

    string errorMessage = null;
    if (!String.IsNullOrEmpty(Model.ErrorMessage))
    {
        var localizedError = L[$"subscribers.account.error.{Model.ErrorMessage}"];
        errorMessage = localizedError.ResourceNotFound ? Model.ErrorMessage : localizedError.Value;

        if (!String.IsNullOrEmpty(Model.ErrorMessageArgument))
        {
            errorMessage = errorMessage.Replace("{0}", Model.ErrorMessageArgument);
        }
    }

    ViewBag.Title = L["subscribers.account.change-required-title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>
    <a href="@Url.Action("Login", "Subscribers")" class="back-button"></a>
    @ViewBag.Title
</h2>
<br />
@if (errorMessage != null)
{
    <div role="alert" style="color:red">@errorMessage</div>
    <br />
}

<p><strong>@L["subscribers.account.change-required-hint"]</strong></p>

@using (Html.BeginForm("LoginChangePassword", "Subscribers", method: FormMethod.Post, htmlAttributes: new { id = "subscriber-change-password-form" }))
{
    <label for="pw-new1">@L["subscribers.account.new-password"]</label>
    <input type="password" id="pw-new1" name="NewPassword1" autocomplete="new-password" required="required" autofocus="autofocus"
           minlength="@SecurityOptions.Value.PasswordMinLength" maxlength="@E.Standard.Api.App.Configuration.SubscriberSecurityOptions.PasswordMaxLength" />
    <br />
    <label for="pw-new2">@L["subscribers.account.new-password-repeat"]</label>
    <input type="password" id="pw-new2" name="NewPassword2" autocomplete="new-password" required="required" />
    <br />
    <small>@L["subscribers.account.password-rules"].Value.Replace("{0}", SecurityOptions.Value.PasswordMinLength.ToString())</small>
    @if (SecurityOptions.Value.PasswordRequiredCharacterClasses > 0)
    {
        <br />
        <small>@L["subscribers.account.password-rules-classes"].Value.Replace("{0}", SecurityOptions.Value.PasswordRequiredCharacterClasses.ToString())</small>
    }
    <br />
    <br />

    @Html.HiddenFor(m => m.Token)
    @if (!String.IsNullOrEmpty(uiLanguage))
    {
        <input type="hidden" name="_ul" value="@uiLanguage" />
    }

    <button type="submit">@L["subscribers.account.change-password"]</button>
}

@section scripts {
    <script type="text/javascript">
        $(function () {
            $('#subscriber-change-password-form').on('submit', function () {
                $(this).find('button[type=submit]').prop('disabled', true);
            });
        });
    </script>
}
