@model E.Standard.Api.App.Models.ApiSubscribersLoginChangePassword

@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory

@{
    var L = LocalizerFactory.Create(typeof(object));
    string uiLanguage = Context.Request.Query["_ul"].FirstOrDefault()
                        ?? (Context.Request.HasFormContentType ? Context.Request.Form["_ul"].FirstOrDefault() : null);

    string errorMessage = null;
    if (!String.IsNullOrEmpty(Model.ErrorMessage))
    {
        var localizedError = L[$"subscribers.account.error.{Model.ErrorMessage}"];
        errorMessage = localizedError.ResourceNotFound ? Model.ErrorMessage : localizedError.Value;

        if (!String.IsNullOrEmpty(Model.ErrorMessageArgument))
        {
            errorMessage = errorMessage.Replace("{0}", Model.ErrorMessageArgument);
        }
    }

    ViewBag.Title = L["subscribers.account.change-required-title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="webgis-auth">
    <div class="webgis-auth-card">
        <div class="webgis-auth-card-header">
            <h2>
                <a href="@Url.Action("Login", "Subscribers")" class="back-button" aria-label="Back"></a>
                @ViewBag.Title
            </h2>
        </div>

        <div class="webgis-auth-card-body">
            @if (errorMessage != null)
            {
                <div role="alert" class="webgis-auth-alert error">@errorMessage</div>
            }

            <div class="webgis-auth-alert warning">@L["subscribers.account.change-required-hint"]</div>

            @using (Html.BeginForm("LoginChangePassword", "Subscribers", method: FormMethod.Post, htmlAttributes: new { id = "subscriber-change-password-form", @class = "webgis-auth-form" }))
            {
                @await Html.PartialAsync("_NewPasswordFields", true)

                @Html.HiddenFor(m => m.Token)
                @if (!String.IsNullOrEmpty(uiLanguage))
                {
                    <input type="hidden" name="_ul" value="@uiLanguage" />
                }

                <button type="submit" class="primary block">@L["subscribers.account.change-password"]</button>
            }
        </div>
    </div>
</div>

@section styles {
    <link href="~/content/subscriber-auth.css" rel="stylesheet" asp-append-version="true" />
}

@section scripts {
    <script src="~/scripts/api/subscriber-auth.js" asp-append-version="true"></script>
}
