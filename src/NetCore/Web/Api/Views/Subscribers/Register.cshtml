@model E.Standard.Api.App.Models.RegisterSubscriberModel
@inject Microsoft.Extensions.Options.IOptions<E.Standard.Api.App.Configuration.SubscriberSecurityOptions> SecurityOptions

@{
    ViewBag.Title = "Edit Api Client";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Register new subscriber</h2>
<br />
<br />

@if (!String.IsNullOrEmpty(Model.ErrorMessage))
{
    <span style="color:red">@(Model.ErrorMessage)</span>
}
<br />
<br />

@using (Html.BeginForm("Register", "Subscribers", FormMethod.Post))
{
    <div id="wizard" class="webgis-wizard" data-wizard-submit-method="submit" data-wizard-submit-title="Register">
        <div class="webgis-wizard-step" data-wizard-step-title="Subscriber">
            @Html.LabelFor(m => m.Username)
            @Html.TextBoxFor(m => m.Username, new { autocomplete = "username" })
            <br />
            @Html.LabelFor(m => m.FirstName)
            @Html.TextBoxFor(m => m.FirstName, new { autocomplete = "given-name" })
            <br />
            @Html.LabelFor(m => m.LastName)
            @Html.TextBoxFor(m => m.LastName, new { autocomplete = "family-name" })
            <br />
            @Html.LabelFor(m => m.Email)
            @Html.TextBoxFor(m => m.Email, new { autocomplete = "email", type = "email" })
            <br />
            @Html.LabelFor(m => m.Password1)
            @Html.PasswordFor(m => m.Password1, new { autocomplete = "new-password", minlength = SecurityOptions.Value.PasswordMinLength, maxlength = E.Standard.Api.App.Configuration.SubscriberSecurityOptions.PasswordMaxLength })
            <br />
            @Html.LabelFor(m => m.Password2)
            @Html.PasswordFor(m => m.Password2, new { autocomplete = "new-password" })
            <br />
            <small>Min. @SecurityOptions.Value.PasswordMinLength characters</small>
            <br />

        </div>
    </div>
}
