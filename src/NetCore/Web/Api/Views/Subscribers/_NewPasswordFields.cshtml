@model bool
@* New password + repeat fields incl. policy hint. Model: autofocus the first field *@

@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@inject Microsoft.Extensions.Options.IOptions<E.Standard.Api.App.Configuration.SubscriberSecurityOptions> SecurityOptions

@{
    var L = LocalizerFactory.Create(typeof(object));
    var options = SecurityOptions.Value;
    string showPasswordLabel = L["subscribers.login.show-password"].Value;
}

<div class="webgis-page-field">
    <label for="pw-new1">@L["subscribers.account.new-password"]</label>
    <div class="webgis-auth-password" data-toggle-label="@showPasswordLabel">
        <input type="password" id="pw-new1" name="NewPassword1" autocomplete="new-password" required="required" autofocus="@(Model ? "autofocus" : null)"
               minlength="@options.PasswordMinLength" maxlength="@E.Standard.Api.App.Configuration.SubscriberSecurityOptions.PasswordMaxLength"
               aria-describedby="pw-rules" />
    </div>
    <div id="pw-rules" class="webgis-page-help">
        @L["subscribers.account.password-rules"].Value.Replace("{0}", options.PasswordMinLength.ToString())
        @if (options.PasswordRequiredCharacterClasses > 0)
        {
            <br />
            @L["subscribers.account.password-rules-classes"].Value.Replace("{0}", options.PasswordRequiredCharacterClasses.ToString())
        }
    </div>
</div>

<div class="webgis-page-field">
    <label for="pw-new2">@L["subscribers.account.new-password-repeat"]</label>
    <div class="webgis-auth-password" data-toggle-label="@showPasswordLabel">
        <input type="password" id="pw-new2" name="NewPassword2" autocomplete="new-password" required="required"
               data-match="pw-new1" data-match-message="@L["subscribers.account.error.passwords-not-equal"]" />
    </div>
</div>
