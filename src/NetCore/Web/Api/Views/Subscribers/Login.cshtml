@using E.Standard.Api.App.Extensions
@model E.Standard.Api.App.Models.ApiSubscribersLogin

@inject E.Standard.Configuration.Services.ConfigurationService config
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory

@{
    var L = LocalizerFactory.Create(typeof(object));
    string uiLanguage = Context.Request.Query["_ul"].FirstOrDefault()
                        ?? (Context.Request.HasFormContentType ? Context.Request.Form["_ul"].FirstOrDefault() : null);

    string errorMessage = null;
    if (!String.IsNullOrEmpty(Model.ErrorMessage))
    {
        var localizedError = L[$"subscribers.login.error.{Model.ErrorMessage}"];
        errorMessage = localizedError.ResourceNotFound
            ? L["subscribers.login.error.login-failed"].Value
            : localizedError.Value;

        if (!String.IsNullOrEmpty(Model.ErrorMessageArgument))
        {
            errorMessage = errorMessage.Replace("{0}", Model.ErrorMessageArgument);
        }
    }

    ViewBag.Title = L["subscribers.login.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>
    <a href="@Url.Action("Index","Home")" class="back-button"></a>
    @L["subscribers.login.title"]
</h2>
<div style="text-align:right">
    <a href="?_ul=de@(String.IsNullOrEmpty(Model.Redirect) ? "" : "&redirect=" + Uri.EscapeDataString(Model.Redirect))">DE</a> |
    <a href="?_ul=en@(String.IsNullOrEmpty(Model.Redirect) ? "" : "&redirect=" + Uri.EscapeDataString(Model.Redirect))">EN</a>
</div>
<br />
@if (errorMessage != null)
{
    <div role="alert" style="color:red">@errorMessage</div>
}
<br />

@using (Html.BeginForm("Login", "Subscribers", method: FormMethod.Post, htmlAttributes: new { id = "subscriber-login-form" }))
{
    <div id="wizard" class="webgis-wizard" data-wizard-submit-method="submit" data-wizard-submit-title="@L["subscribers.login.submit"]">
        <div class="webgis-wizard-step" data-wizard-step-title="Subscriber">
            <label for="Username">@L["subscribers.login.username"]</label>
            @Html.TextBoxFor(m => m.Username, new { autocomplete = "username", autocapitalize = "none", spellcheck = "false", required = "required", autofocus = "autofocus" })
            <br />
            <label for="Password">@L["subscribers.login.password"]</label>
            @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password", required = "required" })
            <div id="subscriber-login-capslock" role="status" style="display:none;color:#b35c00">@L["subscribers.login.capslock"]</div>
            <label style="font-weight:normal">
                <input type="checkbox" id="subscriber-login-show-password" />
                @L["subscribers.login.show-password"]
            </label>
            <br />
            @if (!String.IsNullOrWhiteSpace(Model.CaptchaCodeEncrypted))
            {
                <input type="hidden" id="CaptchaCodeEncrypted" name="CaptchaCodeEncrypted" value="@Model.CaptchaCodeEncrypted" />
                <img id="subscriber-login-captcha-image" src="data:image/png;base64, @Model.CaptchaDataBase64" alt="@L["subscribers.login.captcha-hint"]" />
                <br />
                <a href="#" id="subscriber-login-captcha-reload" data-url="@Url.Action("LoginCaptcha", "Subscribers")">@L["subscribers.login.captcha-reload"]</a>
                <div id="subscriber-login-captcha-reload-failed" role="alert" style="display:none;color:red">@L["subscribers.login.captcha-reload-failed"]</div>
                <br />
                <label for="CaptchaInput">@L["subscribers.login.captcha"]</label>
                @Html.TextBoxFor(m => m.CaptchaInput, new { autocomplete = "off", autocapitalize = "characters", spellcheck = "false", required = "required" })
                <br />
            }

            @Html.HiddenFor(m => m.Redirect)
            @if (!String.IsNullOrEmpty(uiLanguage))
            {
                <input type="hidden" name="_ul" value="@uiLanguage" />
            }
        </div>
    </div>
}

<br />
<br />

@if (config.AllowRegisterNewSubscribers())
{
    @Html.ActionLink(L["subscribers.login.register"].Value, "Register")
}

@section scripts {
    <script type="text/javascript">
        $(function () {
            var $password = $('#Password');

            $('#subscriber-login-show-password').on('change', function () {
                $password.attr('type', this.checked ? 'text' : 'password');
            });

            $password.on('keyup keydown', function (e) {
                var capsLock = e.originalEvent && e.originalEvent.getModifierState && e.originalEvent.getModifierState('CapsLock');
                $('#subscriber-login-capslock').css('display', capsLock ? 'block' : 'none');
            });

            if ($('#CaptchaInput').length && $('#Username').val()) {
                $('#Password').trigger('focus');
            }

            $('#subscriber-login-captcha-reload').on('click', function (e) {
                e.preventDefault();
                $.ajax({ url: $(this).data('url'), cache: false, dataType: 'json' })
                    .done(function (result) {
                        $('#CaptchaCodeEncrypted').val(result.encrypted);
                        $('#subscriber-login-captcha-image').attr('src', 'data:image/png;base64, ' + result.base64);
                        $('#CaptchaInput').val('').trigger('focus');
                        $('#subscriber-login-captcha-reload-failed').css('display', 'none');
                    })
                    .fail(function () {
                        $('#subscriber-login-captcha-reload-failed').css('display', 'block');
                    });
            });

            $('#subscriber-login-form').on('submit', function () {
                // never submit a visible (plain text) password field state to the browser history/autofill
                $password.attr('type', 'password');
                $(this).find('button[type=submit]')
                    .prop('disabled', true)
                    .text(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["subscribers.login.submitting"].Value)));
            });
        });
    </script>
}
