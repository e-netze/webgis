@using E.Standard.Api.App.Extensions
@model E.Standard.Api.App.Models.ApiSubscribersLogin

@inject E.Standard.Configuration.Services.ConfigurationService config
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@inject E.Standard.Localization.Abstractions.ICultureProvider CultureProvider

@{
    var L = LocalizerFactory.Create(typeof(object));
    string uiLanguage = Context.Request.Query["_ul"].FirstOrDefault()
                        ?? (Context.Request.HasFormContentType ? Context.Request.Form["_ul"].FirstOrDefault() : null);

    string errorMessage = null;
    if (!String.IsNullOrEmpty(Model.ErrorMessage))
    {
        var localizedError = L[$"subscribers.login.error.{Model.ErrorMessage}"];
        errorMessage = localizedError.ResourceNotFound
            ? L["subscribers.login.error.login-failed"].Value
            : localizedError.Value;

        if (!String.IsNullOrEmpty(Model.ErrorMessageArgument))
        {
            errorMessage = errorMessage.Replace("{0}", Model.ErrorMessageArgument);
        }
    }

    ViewBag.Title = L["subscribers.login.title"].Value;
    ViewData["page-has-language-switch"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";

    string redirectQuery = String.IsNullOrEmpty(Model.Redirect) ? "" : "&redirect=" + Uri.EscapeDataString(Model.Redirect);
    string activeLanguage = CultureProvider.Culture?.ToLowerInvariant();
}

<div class="webgis-page narrow">
    <div class="webgis-page-card">
        <div class="webgis-page-card-header">
            <div class="webgis-page-header-row">
                <h2>@L["subscribers.login.title"]</h2>
                <nav class="webgis-page-lang" aria-label="Language">
                    <a href="?_ul=de@(redirectQuery)" class="@(activeLanguage == "de" ? "active" : "")" lang="de">DE</a>
                    <a href="?_ul=en@(redirectQuery)" class="@(activeLanguage == "en" ? "active" : "")" lang="en">EN</a>
                </nav>
            </div>
        </div>

        <div class="webgis-page-card-body">
            @if (errorMessage != null)
            {
                <div role="alert" class="webgis-page-alert error">@errorMessage</div>
            }

            @using (Html.BeginForm("Login", "Subscribers", method: FormMethod.Post, htmlAttributes: new { id = "subscriber-login-form", @class = "webgis-auth-form" }))
            {
                <div class="webgis-page-field">
                    <label for="Username">@L["subscribers.login.username"]</label>
                    @Html.TextBoxFor(m => m.Username, new { autocomplete = "username", autocapitalize = "none", spellcheck = "false", required = "required", autofocus = "autofocus" })
                </div>

                <div class="webgis-page-field">
                    <label for="Password">@L["subscribers.login.password"]</label>
                    <div class="webgis-auth-password" data-toggle-label="@L["subscribers.login.show-password"]">
                        @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password", required = "required", data_capslock_hint = "subscriber-login-capslock" })
                    </div>
                    <div id="subscriber-login-capslock" role="status" class="webgis-page-help" style="display:none;color:#b35c00">&#9888; @L["subscribers.login.capslock"]</div>
                </div>

                @if (!String.IsNullOrWhiteSpace(Model.CaptchaCodeEncrypted))
                {
                    <div class="webgis-page-field">
                        <input type="hidden" id="CaptchaCodeEncrypted" name="CaptchaCodeEncrypted" value="@Model.CaptchaCodeEncrypted" />
                        <div class="webgis-auth-captcha">
                            <img id="subscriber-login-captcha-image" src="data:image/png;base64, @Model.CaptchaDataBase64" alt="@L["subscribers.login.captcha-hint"]" />
                            <a href="#" id="subscriber-login-captcha-reload" class="webgis-page-link" data-url="@Url.Action("LoginCaptcha", "Subscribers")">&#8635; @L["subscribers.login.captcha-reload"]</a>
                        </div>
                        <div id="subscriber-login-captcha-reload-failed" role="alert" class="webgis-page-alert error" style="display:none">@L["subscribers.login.captcha-reload-failed"]</div>
                        <label for="CaptchaInput">@L["subscribers.login.captcha"]</label>
                        @Html.TextBoxFor(m => m.CaptchaInput, new { autocomplete = "off", autocapitalize = "characters", spellcheck = "false", required = "required" })
                        <div class="webgis-page-help">@L["subscribers.login.captcha-hint"]</div>
                    </div>
                }

                @Html.HiddenFor(m => m.Redirect)
                @if (!String.IsNullOrEmpty(uiLanguage))
                {
                    <input type="hidden" name="_ul" value="@uiLanguage" />
                }

                <button type="submit" class="primary block" data-submitting="@L["subscribers.login.submitting"]">@L["subscribers.login.submit"]</button>
            }
        </div>

        @if (config.AllowRegisterNewSubscribers())
        {
            <div class="webgis-page-card-footer">
                @Html.ActionLink(L["subscribers.login.register"].Value, "Register")
            </div>
        }
    </div>
</div>

@section styles {
    <link href="~/content/subscriber-auth.css" rel="stylesheet" asp-append-version="true" />
}

@section scripts {
    <script src="~/scripts/api/subscriber-auth.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            if ($('#CaptchaInput').length && $('#Username').val()) {
                $('#Password').trigger('focus');
            }

            $('#subscriber-login-captcha-reload').on('click', function (e) {
                e.preventDefault();
                $.ajax({ url: $(this).data('url'), cache: false, dataType: 'json' })
                    .done(function (result) {
                        $('#CaptchaCodeEncrypted').val(result.encrypted);
                        $('#subscriber-login-captcha-image').attr('src', 'data:image/png;base64, ' + result.base64);
                        $('#CaptchaInput').val('').trigger('focus');
                        $('#subscriber-login-captcha-reload-failed').css('display', 'none');
                    })
                    .fail(function () {
                        $('#subscriber-login-captcha-reload-failed').css('display', 'block');
                    });
            });
        });
    </script>
}
