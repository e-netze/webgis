<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>

	<!-- Shared Crypto Keys -->
	<add key="shared-crypto-keys-path" value="{api-repository-path}/security/keys"/>

    <add key="graphics-engine" value="skia"/> <!-- skia/gdiplus, no value = system default -->

	<!-- App Roles -->
    <add key="app-roles" value="all" />													 <!-- webgisapi,datalinq,datalinqstudio,subscriberpages   default: all -->
	   
    <!-- CMS -->
    <add key="cmspath_default" value="{api-repository-path}/cms/publish/cms-default.xml" />    <!-- Path to the CMS named ccgis_default. Names matter, they are used to tell CMS files apart when creating maps. Names should not be changed afterwards -->
	<add key="cmspath_{company}" value="{api-repository-path}/cms/publish/cms-{company}.xml" />
	<add key="cmsgdischema_default" value="" />										      <!-- GDI schema from the CMS used by default -->
    
    <!-- Output Path and Url -->
    <add key="outputPath" value="{api-repository-path}/output" />                           <!-- Path to the output directory -->
    <add key="outputUrl" value="{api-onlineresource}/output" />                        <!-- Url to the output directory. Must be reachable for the end user -->
    <add key="server-side-configuration-path" value="{api-repository-path}/configuration"/> <!-- Path to the configuration -->

    <!-- Proj4 Database -->
    <add key="p4database" value="#" />                                    <!-- ConnectionString to the P4 database, "#" => use internal connections -->
    <add key="p4_default" value="{default-calc-crs}" />

    <!-- API Security -->
    <add key="api-security" value="hmac" />

    <!-- Cache Database -->
    <!---->
    <add key="cache-provider" value="fs" />
    <add key="cache-connectionstring" value="{api-repository-path}/db/cache" />

	<!-- Cache Aside -->
	<add key="cache-aside-provider" value="inapp" />  <!-- optional: empty, redis, inapp -->
	<add key="cache-aside-connectionstring" value="3600" />  <!-- 3600 seconds caching -->  <!-- ConnectionString to redis, e.g. localhost:6379 -->

	<!-- Subscriber Database -->
    <add key="subscriber-db-connectionstring" value="fs:{api-repository-path}/db/subscriber" />  <!-- Path to CMS without name --> 
    <add key="subscriber-admins" value="admin" />                                           <!-- Names of the admins (comma-separated) -->

    <!-- Subscriber Registration -->
    <add key="allow-subscriber-login" value="true" />                                <!-- default: true  if false, login is no longer possible (Security: no more configuration from the internet) -->
    <add key="allow-register-new-subscribers" value="true" />                        <!-- may subscribers register themselves -->
    <add key="subscription-tools" value="clients,portal-pages,datalinq-endpoints" /> <!-- What may subscribers use? clients, portals,datalinq-endpoints (default-value: clients) -->
    <add key="portal-allowed-creators" value="*" />                                  <!-- * -->   

    <!-- Subscriber Portal -->
	<add key="api-url" value="{api-onlineresource}" />                                         <!-- Url the Api is reachable at from outside. Header placeholders are allowed -->
    <add key="portal-url" value="{portal-onlineresource}" />                                   <!-- Url the Portal is reachable at from outside. Header placeholders are allowed -->
    <add key="portal-internal-url" value="{portal-internal-url}" />                          <!-- Url for internal communication between Api and Portal. Must be accessible anonymously (e.g. localhost) -->
	  
    <!-- Storage -->
    <add key="storage-rootpath" value="{api-repository-path}/db/storage" />               <!-- Path to the storage folder. Created automatically if it doesn't exist -->
    <add key="ImpersonateUser" value="" />                                           <!-- Should no longer be used. Only if WebGIS otherwise has no write permissions on the storage directory -->
    
    <!-- Logging (optional) -->
    <!-- Comma-separated list of backends: files, microsoft, sqlserver, postgres, sqlite (any combination, e.g. "files,microsoft") -->
    <add key="logging-type" value="files" />

    <add key="logging-log-performance" value="false" />
    <add key="Log_Performance_Columns" value="SESSIONID;MAPREQUESTID;CLIENTIP;DATE;TIME;MAPNAME;USERNAME;X;Y;SCALE" />
    <add key="logging-log-exceptions" value="true" />
    <add key="Log_Path" value="{api-repository-path}/logs" />                           <!-- Path for logging: WebGIS needs write permissions on this directory -->

    <!-- How (and whether) usernames are written to performance/exception logs: "plaintext" (default), "hash" (SHA-256 hash only), "none" (not at all) -->
    <!-- <add key="logging-username-mode" value="plaintext" /> -->

    <!-- Only needed when logging-type contains "sqlserver"/"postgres"/"sqlite" - webgis_performance/webgis_exceptions tables are created automatically -->
    <!-- <add key="logging-sqlserver-connectionstring" value="Server=.;Database=webgis;User Id=...;Password=...;" /> -->
    <!-- <add key="logging-postgres-connectionstring" value="Host=localhost;Database=webgis;Username=...;Password=...;" /> -->
    <!-- <add key="logging-sqlite-connectionstring" value="Data Source={api-repository-path}/logs/webgis.db" /> -->

    <!-- OGC -->
    <add key="ogc-online-resource" value="~" />
    <add key="ogc-ticket-db" value="" />
    <add key="ogc-login-service"  value="" />
    <add key="ogc-logout-service" value="" />
    <add key="ogc-default-supported-crs" value="" />     <!-- default value 4326 -->

	 <section name="tool-mapmarkup">
	    <add key="allow-add-from-selection" value="true" />
		<add key="allow-add-from-selection-max-features" value="1000" />
		<add key="allow-add-from-selection-max-vertices" value="10000" />
		<add key="allow-download-from-selection" value="true" />
		<add key="default-download-epsg" value="4326" />
	 </section>

	  <section name="tool-coordinates">
		  <add key="allow-upload-max-rows" value="200" />
	  </section>

	  <section name="tool-print">
		  <add key="qualities-dpi" value="150:Hoch (150 dpi),120:Mittel (120 dpi),225:Sehr hoch (225 dpi)" />
		  <add key="scales" value="1000000,500000,250000,100000,50000,25000,10000,5000,3000,2000,1000,500,250,100" />
		  <add key="default-format" value="A4.Landscape" />
		  <add key="scale-wysiwyg" value="false" />
	  </section>

	  <section name="tool-liveshare">
		  <add key="simplify-session-ids" value="true" />

		  <add key="hub" value="https://liveshare.webgiscloud.com" />
		  <add key="clientId" value="gültige client Id" />
		  <add key="clientSecret" value="gültiges client secret" />
	  </section>

	  <section name="tool-threed">
		  <add key="min-resolution" value="5" />
		  <add key="max-resolution" value="100" />
		  <add key="max-model-size" value="1500" />
		  <add key="max-scale" value="100000" />
		  <add key="texture-ortho-service" value="geoland_bm_of@default:0" />                        <!-- serviceId:layerId -->
		  <add key="texture-streets-overlay-service" value="geoland_bm_ov@default:0" />     	     <!-- serviceId:layerId -->
	  </section>

	  <section name="tool-share">
		  <add key="duration" value="1:1 Tag, 7:1 Woche, 31:1 Monat, 365: 1 Jahr, 36500:Für immer" />
	  </section>

	  <section name="tool-identify">
		  <add key="tolerance" value="20" />   <!-- pixel -->
		  <add key="tolerance-for-point-layers" value="10" />
		  <add key="tolerance-for-line-layers" value="5" />
		  <add key="tolerance-for-polygon-layers" value="0" />
		  <add key="show-layer-visibility-checkboxes" value="true" />

		  <!-- ArcGIS Server spatial-query bounding-box workaround (see AgsQuerySettings) -->
		  <add key="ags-spatial-query-max-result-cap" value="2000" />
		  <add key="ags-spatial-query-default-max-record-count-fallback" value="1000" />
		  <add key="ags-spatial-query-max-parallel-batch-requests" value="4" />
		  <add key="ags-spatial-query-ids-timeout-seconds" value="20" />
		  <add key="ags-spatial-query-ids-paging-threshold" value="50000" />
	  </section>

	  <section name="proxy">
		  <add key="use" value="false" />
		  <add key="server" value="" />
		  <add key="port" value="" />

		  <add key="user" value="" />
		  <add key="pwd"  value="" />
		  <add key="domain" value="" />
		  <add key="ignore" value="localhost;localhost:5000" />
	  </section>

	  <section name="datalinq">
		  <add key="include" value="true" />
		  <add key="allow-code-editing" value="true" />
		  
		  <add key="api-encryption-level" value="DefaultStaticEncryption" />
			
		  <!--
		  <add key="environment" value="development" />
			<add key="initialize-sandbox-on-startup" value="true" />
		  
		  <add key="add-namespaces" value="" />

		  <add key="add-css" value="~/content/styles/company/default.css?{version}" />
		  <add key="add-js" value="~/scripts/api/three_d.js?{version}" />
		  
		  <add key="api-engine-connection-replacements" value="" />
      -->		  
	  </section>
  </appSettings>
</configuration>