{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "custom-css webgis-dependencies webgis-dependency-hasselection webgis-static-overlay-control",
          "element-target": "default",
          "id": "elem",
          "style": "width:100px"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "webgisValueElement": "[jQuery(1):input.webgis-selected-id]",
          "webgis_staticOverlayControl": "[object Ctor]"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-selected-id",
              "type": "hidden"
            },
            "props": {
              "value": ""
            }
          },
          {
            "tag": "div",
            "listeners": {
              "dragenter": 1,
              "dragover": 1,
              "pointerdown": 1
            },
            "expandos": {
              "Sortable{timestamp}": "[object Bt]"
            }
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.serviceIds",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
