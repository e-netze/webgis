{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-edittheme-tree",
          "element-target": "default",
          "id": "combo"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "options": {
            "customitems": null,
            "dbrights": "u",
            "id": "combo",
            "map": "[fake:map]",
            "onchange": null
          },
          "webgisValueElement": "[jQuery(1):input]",
          "webgis_editthemeTree": "[object Ctor]"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "value": "s1"
            },
            "props": {
              "value": "s1"
            }
          },
          {
            "tag": "select",
            "attrs": {
              "class": "webgis-edittheme-tree-service-combo webgis-input webgis-tags-combo",
              "id": "webgis-edittheme-tree-service-combo"
            },
            "props": {
              "value": "s1",
              "selectedIndex": 0
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "itemContainer": "[jQuery(1):div#combo.webgis-edittheme-tree]",
              "itemSelector": ".webgis-tag-item",
              "itemTagsAttr": "tags",
              "tags": [
                "a",
                "b"
              ],
              "webgis_tagsCombo": "[object Ctor]"
            },
            "events": {
              "change.webgis_editthemeTree": 1,
              "click.webgis_tagscombo": 1,
              "mousemove.webgis_tagscombo": 1
            },
            "expandos": {
              "0": "[element:option]"
            },
            "children": [
              {
                "tag": "option",
                "attrs": {
                  "value": "s1"
                },
                "props": {
                  "selected": true
                },
                "children": [
                  "Dienst 1"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-tags-combo-popup",
              "style": "display: none; position: absolute;"
            },
            "events": {
              "mouseout.webgis_tagscombo": 1,
              "mouseover.webgis_tagscombo": 1
            },
            "children": [
              {
                "tag": "button",
                "attrs": {
                  "class": "webgis-tag-button all"
                },
                "events": {
                  "click.webgis_tagscombo": 1
                },
                "children": [
                  "Alle anzeigen"
                ]
              },
              {
                "tag": "button",
                "attrs": {
                  "class": "webgis-tag-button",
                  "tag": "a"
                },
                "events": {
                  "click.webgis_tagscombo": 1
                },
                "children": [
                  "a"
                ]
              },
              {
                "tag": "button",
                "attrs": {
                  "class": "webgis-tag-button",
                  "tag": "b"
                },
                "events": {
                  "click.webgis_tagscombo": 1
                },
                "children": [
                  "b"
                ]
              }
            ]
          },
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-tags-combo-value webgis-tool-parameter",
              "id": "combo-tags",
              "type": "hidden",
              "value": ""
            },
            "props": {
              "value": ""
            }
          },
          {
            "tag": "ul",
            "attrs": {
              "class": "webgis-edittheme-tree-theme-list"
            },
            "children": [
              {
                "tag": "li",
                "attrs": {
                  "class": "webgis-edittheme-tree-theme-list-item webgis-tag-item",
                  "data-edittheme": "s1,l1,t1",
                  "data-serviceid": "s1",
                  "style": "display: block; background-image: url(\"https://webgis.test/rest/services/s1/getlegendlayeritem?f=bin&layer=l1&value=undefined\");",
                  "tags": "a,b",
                  "title": "Tags: #a, #b"
                },
                "events": {
                  "click.webgis_editthemeTree": 1
                },
                "children": [
                  "Thema 1",
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "checkbox checked"
                    },
                    "data": {
                      "layerIds": [
                        "l1"
                      ]
                    },
                    "events": {
                      "click.webgis_editthemeTree": 1
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "service.checkLayerVisibility",
      "args": [
        [
          "l1"
        ]
      ]
    },
    {
      "call": "map.events.on",
      "args": [
        "onaddservice",
        "[function]"
      ]
    },
    {
      "call": "map.events.on",
      "args": [
        "onremoveservice",
        "[function]"
      ]
    },
    {
      "call": "map.ui.refreshUIElements",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
