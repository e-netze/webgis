{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "custom-css webgis-dependencies webgis-dependency-hasselection webgis-edittheme-tree",
          "element-target": "default",
          "id": "combo",
          "style": "width:100px"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "options": {
            "customitems": null,
            "dbrights": null,
            "id": "combo",
            "map": "[fake:map]",
            "onchange": null
          },
          "webgisValueElement": "[jQuery(1):input]",
          "webgis_editthemeTree": "[object Ctor]"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "value": ""
            },
            "props": {
              "value": ""
            }
          },
          {
            "tag": "select",
            "attrs": {
              "class": "webgis-edittheme-tree-service-combo webgis-input",
              "id": "webgis-edittheme-tree-service-combo"
            },
            "props": {
              "value": "",
              "selectedIndex": -1
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "itemContainer": "[jQuery(1):div#combo.custom-css.webgis-dependencies.webgis-dependency-hasselection.webgis-edittheme-tree]",
              "itemSelector": ".webgis-tag-item",
              "itemTagsAttr": "tags",
              "tags": [],
              "webgis_tagsCombo": "[object Ctor]"
            },
            "events": {
              "change.webgis_editthemeTree": 1,
              "click.webgis_tagscombo": 1,
              "mousemove.webgis_tagscombo": 1
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-tags-combo-popup",
              "style": "display: none; position: absolute;"
            },
            "events": {
              "mouseout.webgis_tagscombo": 1,
              "mouseover.webgis_tagscombo": 1
            }
          },
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-tags-combo-value webgis-tool-parameter",
              "id": "combo-tags",
              "type": "hidden",
              "value": ""
            },
            "props": {
              "value": ""
            }
          },
          {
            "tag": "ul",
            "attrs": {
              "class": "webgis-edittheme-tree-theme-list"
            }
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.on",
      "args": [
        "onaddservice",
        "[function]"
      ]
    },
    {
      "call": "map.events.on",
      "args": [
        "onremoveservice",
        "[function]"
      ]
    },
    {
      "call": "map.ui.refreshUIElements",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
