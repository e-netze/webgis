{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "li",
        "attrs": {
          "class": "webgis-toolbox-tool-item",
          "element-target": "default",
          "id": "i1",
          "style": "padding: 36px 4px 4px 105px; background-image: url(\"https://webgis.test/ui/large.png\"); background-position: 2px 10px; background-size: 90px; background-repeat: no-repeat; height: 110px; white-space: normal;"
        },
        "children": [
          {
            "tag": "div",
            "children": [
              "Eintrag"
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
