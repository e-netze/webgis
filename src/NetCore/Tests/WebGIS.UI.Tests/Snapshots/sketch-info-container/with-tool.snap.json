{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    }
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-modal",
          "id": "webgis-modal-server-button-modal-dialog",
          "style": "z-index:9999;position:fixed;left:0px;right:0px;top:0px;bottom:0px;background:rgba(0,0,0,0.5);"
        },
        "events": {
          "click": 1,
          "mousedown": 1
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-modal-body center animate",
              "id": "",
              "style": "z-index: 1000; position: absolute; width: 330px; height: 640px; min-width: 330px; max-width: 100%; background: var(--webgis-ui-surface); opacity: 1; display: block; left: 475px; top: 40px; max-height: calc(100% - 80px); min-height: 0px;"
            },
            "events": {
              "click": 1
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-modal-content",
                  "id": "webgis-modal-content",
                  "style": "z-index:1;position:absolute;overflow:auto;left:0px;top:calc(43px + var(--webgis-ui-border-width-item-selected));right:0px;bottom:0px"
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-sketch-info-container-holder",
                      "element-target": "default"
                    },
                    "data": {
                      "__plugins__": [
                        "[object Ctor]"
                      ],
                      "map": "[fake:map]",
                      "webgis_sketchInfoContainer": "[object Ctor]"
                    },
                    "children": [
                      {
                        "tag": "table",
                        "children": [
                          {
                            "tag": "tbody",
                            "children": [
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "th",
                                    "attrs": {
                                      "colspan": "2"
                                    },
                                    "children": [
                                      "Sketch"
                                    ]
                                  }
                                ]
                              },
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "td",
                                    "children": [
                                      "Geometrie-Typ:"
                                    ]
                                  },
                                  {
                                    "tag": "td",
                                    "attrs": {
                                      "class": "sketch-info-item sketch-geometrytype"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "tag": "table",
                        "attrs": {
                          "class": "sketch-segment-clickable",
                          "title": "Richtung/Abstand"
                        },
                        "events": {
                          "click": 1
                        },
                        "children": [
                          {
                            "tag": "tbody",
                            "children": [
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "th",
                                    "attrs": {
                                      "colspan": "2"
                                    },
                                    "children": [
                                      "Segment"
                                    ]
                                  }
                                ]
                              },
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "td",
                                    "children": [
                                      "Segment Länge:"
                                    ]
                                  },
                                  {
                                    "tag": "td",
                                    "attrs": {
                                      "class": "sketch-info-item segment-length"
                                    }
                                  }
                                ]
                              },
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "td",
                                    "children": [
                                      "Segment Azimut:"
                                    ]
                                  },
                                  {
                                    "tag": "td",
                                    "attrs": {
                                      "class": "sketch-info-item segment-azimut-deg"
                                    }
                                  }
                                ]
                              },
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "td"
                                  },
                                  {
                                    "tag": "td",
                                    "attrs": {
                                      "class": "sketch-info-item segment-azimut-grad"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "tag": "div",
                        "attrs": {
                          "style": "display: none;"
                        }
                      },
                      {
                        "tag": "table",
                        "children": [
                          {
                            "tag": "tbody",
                            "children": [
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "th",
                                    "attrs": {
                                      "colspan": "2"
                                    },
                                    "children": [
                                      "Snapping"
                                    ]
                                  }
                                ]
                              },
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "td",
                                    "children": [
                                      "Snappen auf:"
                                    ]
                                  },
                                  {
                                    "tag": "td",
                                    "attrs": {
                                      "class": "sketch-info-item snap-result-type"
                                    }
                                  }
                                ]
                              },
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "td",
                                    "children": [
                                      "Thema:"
                                    ]
                                  },
                                  {
                                    "tag": "td",
                                    "attrs": {
                                      "class": "sketch-info-item snap-result-name"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "tag": "table"
                      },
                      {
                        "tag": "ul",
                        "attrs": {
                          "class": "webgis-contextmenu webgis-tool-contextmenu icons",
                          "style": "box-shadow: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"
                        },
                        "children": [
                          {
                            "tag": "li",
                            "attrs": {
                              "class": "ortho-off webgis-toolbox-tool-item",
                              "style": "background-image: url(\"https://webgis.test/rest/imageresource/sketch_ortho_off-26~png?sub=tools&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); display: none; width: 100%; box-sizing: border-box; text-align: left;"
                            },
                            "events": {
                              "click": 1
                            },
                            "children": [
                              "Orthogonal-Modus beenden"
                            ]
                          },
                          {
                            "tag": "li",
                            "attrs": {
                              "class": "trace-off webgis-toolbox-tool-item",
                              "style": "background-image: url(\"https://webgis.test/rest/imageresource/sketch_trace_off-26~png?sub=tools&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); display: none; width: 100%; box-sizing: border-box; text-align: left;"
                            },
                            "events": {
                              "click.webgis_sketch_info_container": 1
                            },
                            "children": [
                              "Trace-Modus beenden"
                            ]
                          },
                          {
                            "tag": "li",
                            "attrs": {
                              "class": "fan-off webgis-toolbox-tool-item",
                              "style": "background-image: url(\"https://webgis.test/rest/imageresource/sketch_fan_off-26~png?sub=tools&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); display: none; width: 100%; box-sizing: border-box; text-align: left;"
                            },
                            "events": {
                              "click.webgis_sketch_info_container": 1
                            },
                            "children": [
                              "Fan-Modus beenden"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "style": "position: absolute; left: 0px; right: 0px; top: 0px; height: 35px; cursor: pointer;"
                },
                "events": {
                  "click": 1
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-title has-closebutton"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-resize"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-close"
                    },
                    "events": {
                      "click": 1
                    },
                    "expandos": {
                      "options": {
                        "animate": true,
                        "blocker_alpha": 0.5,
                        "blockerclickclose": true,
                        "closebutton": true,
                        "dock": "center",
                        "hasBlocker": true,
                        "height": "80%",
                        "id": "server-button-modal-dialog",
                        "meta_left_frame": false,
                        "minWidth": "330px",
                        "mobile_fullscreen": true,
                        "slide": true,
                        "title": "",
                        "titleButtons": null,
                        "width": "330px"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "body": [],
  "calls": [
    {
      "call": "map.events.fire",
      "args": [
        "onbuildtoolui",
        "test-tool"
      ]
    },
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.advancedToolBehaviour",
      "args": []
    },
    {
      "call": "map.ui.webgisContainer",
      "args": []
    },
    {
      "call": "map.ui.webgisContainer",
      "args": []
    },
    {
      "call": "map.ui.webgisContainer",
      "args": []
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.sketchInfoOverlayContainer",
      "args": []
    },
    {
      "call": "map.graphics._isGraphicsToolActive",
      "args": []
    },
    {
      "call": "map.toolSketch",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#webgis-modal-content.webgis-modal-content]",
          "target": "default"
        }
      ]
    }
  ]
}
