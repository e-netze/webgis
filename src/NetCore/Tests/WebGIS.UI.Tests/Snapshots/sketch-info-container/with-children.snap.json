{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    }
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [
    {
      "tag": "div",
      "attrs": {
        "id": "sketch-overlay"
      },
      "children": [
        {
          "tag": "div",
          "attrs": {
            "class": "webgis-sketch-info-container-holder",
            "element-target": "default"
          },
          "data": {
            "__plugins__": [
              "[object Ctor]"
            ],
            "map": "[fake:map]",
            "webgis_sketchInfoContainer": "[object Ctor]"
          },
          "children": [
            {
              "tag": "table",
              "children": [
                {
                  "tag": "tbody",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "th",
                          "attrs": {
                            "colspan": "2"
                          },
                          "children": [
                            "Sketch"
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td",
                          "children": [
                            "Geometrie-Typ:"
                          ]
                        },
                        {
                          "tag": "td",
                          "attrs": {
                            "class": "sketch-info-item sketch-geometrytype"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "table",
              "attrs": {
                "class": "sketch-segment-clickable",
                "title": "Richtung/Abstand"
              },
              "events": {
                "click": 1
              },
              "children": [
                {
                  "tag": "tbody",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "th",
                          "attrs": {
                            "colspan": "2"
                          },
                          "children": [
                            "Segment"
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td",
                          "children": [
                            "Segment Länge:"
                          ]
                        },
                        {
                          "tag": "td",
                          "attrs": {
                            "class": "sketch-info-item segment-length"
                          }
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td",
                          "children": [
                            "Segment Azimut:"
                          ]
                        },
                        {
                          "tag": "td",
                          "attrs": {
                            "class": "sketch-info-item segment-azimut-deg"
                          }
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td"
                        },
                        {
                          "tag": "td",
                          "attrs": {
                            "class": "sketch-info-item segment-azimut-grad"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "style": "display: none;"
              }
            },
            {
              "tag": "table",
              "children": [
                {
                  "tag": "tbody",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "th",
                          "attrs": {
                            "colspan": "2"
                          },
                          "children": [
                            "Snapping"
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td",
                          "children": [
                            "Snappen auf:"
                          ]
                        },
                        {
                          "tag": "td",
                          "attrs": {
                            "class": "sketch-info-item snap-result-type"
                          }
                        }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td",
                          "children": [
                            "Thema:"
                          ]
                        },
                        {
                          "tag": "td",
                          "attrs": {
                            "class": "sketch-info-item snap-result-name"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "table"
            },
            {
              "tag": "ul",
              "attrs": {
                "class": "webgis-contextmenu webgis-tool-contextmenu icons",
                "style": "box-shadow: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"
              },
              "children": [
                {
                  "tag": "li",
                  "attrs": {
                    "class": "ortho-off webgis-toolbox-tool-item",
                    "style": "background-image: url(\"https://webgis.test/rest/imageresource/sketch_ortho_off-26~png?sub=tools&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); display: none; width: 100%; box-sizing: border-box; text-align: left;"
                  },
                  "events": {
                    "click": 1
                  },
                  "children": [
                    "Orthogonal-Modus beenden"
                  ]
                },
                {
                  "tag": "li",
                  "attrs": {
                    "class": "trace-off webgis-toolbox-tool-item",
                    "style": "background-image: url(\"https://webgis.test/rest/imageresource/sketch_trace_off-26~png?sub=tools&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); display: none; width: 100%; box-sizing: border-box; text-align: left;"
                  },
                  "events": {
                    "click.webgis_sketch_info_container": 1
                  },
                  "children": [
                    "Trace-Modus beenden"
                  ]
                },
                {
                  "tag": "li",
                  "attrs": {
                    "class": "fan-off webgis-toolbox-tool-item",
                    "style": "background-image: url(\"https://webgis.test/rest/imageresource/sketch_fan_off-26~png?sub=tools&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); display: none; width: 100%; box-sizing: border-box; text-align: left;"
                  },
                  "events": {
                    "click.webgis_sketch_info_container": 1
                  },
                  "children": [
                    "Fan-Modus beenden"
                  ]
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "id": "child"
              }
            }
          ]
        }
      ]
    }
  ],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.sketchInfoOverlayContainer",
      "args": []
    },
    {
      "call": "map.graphics._isGraphicsToolActive",
      "args": []
    },
    {
      "call": "map.toolSketch",
      "args": []
    },
    {
      "call": "map.updateSketchInfoOverlayVisibility",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
