{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "contains-labels webgis-ui-optionscontainer",
          "element-target": "default"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-imagebutton",
              "style": "background-image: url(\"mail.png\");"
            },
            "data": {
              "link": "https://example.org/share",
              "qr_base64": "qr",
              "shareOption": {
                "available": "[function]",
                "img": "[function]",
                "name": "Mail",
                "share": "[fake:shareOption.mail.share]"
              },
              "subject": "Betreff"
            },
            "events": {
              "click": 1
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-ui-imagebutton-text"
                },
                "children": [
                  "Mail"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "shareOption.mail.share",
      "args": [
        "https://example.org/share",
        "Betreff",
        "qr"
      ]
    }
  ]
}
