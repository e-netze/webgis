{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "custom-css webgis-dependencies webgis-dependency-hasselection webgis-size-input-holder",
          "element-target": "default",
          "id": "elem",
          "style": "width:100px"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "webgis_size_input": "[object Ctor]"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-size-input webgis-size-x",
              "type": "number"
            },
            "props": {
              "value": ""
            },
            "events": {
              "change.webgis_size_input": 1
            }
          },
          {
            "tag": "div",
            "children": [
              "x"
            ]
          },
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-size-input webgis-size-y",
              "type": "number"
            },
            "props": {
              "value": ""
            },
            "events": {
              "change.webgis_size_input": 1
            }
          },
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-size-value",
              "type": "hidden"
            },
            "props": {
              "value": ""
            }
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
