{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-ui-droplist",
          "data-id": "drop",
          "element-target": "default",
          "id": "drop_droplist"
        },
        "data": {
          "calcVal": "[function]",
          "map": "[fake:map]"
        },
        "events": {
          "dragover": 1,
          "drop": 1
        }
      },
      {
        "tag": "input",
        "attrs": {
          "id": "drop",
          "type": "hidden",
          "value": ""
        },
        "props": {
          "value": ""
        }
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
