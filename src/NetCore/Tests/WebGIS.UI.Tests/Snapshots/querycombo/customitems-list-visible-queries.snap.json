{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "select",
        "attrs": {
          "class": "webgis-select webgis-query-combo require-ui-refresh",
          "element-target": "default",
          "id": "combo"
        },
        "props": {
          "value": "#",
          "selectedIndex": 0
        },
        "expandos": {
          "0": "[element:option.webgis-custom-option]",
          "1": "[element:option.webgis-custom-option]",
          "_map": "[fake:map]",
          "_opt": {
            "customitems": [
              {
                "category": null,
                "name": "Eigenes 1",
                "value": "#"
              },
              {
                "category": "Kategorie",
                "name": "Eigenes 2",
                "value": "c2"
              }
            ],
            "map": "[fake:map]",
            "onchange": null,
            "type": "query",
            "valuefunction": null
          }
        },
        "children": [
          {
            "tag": "option",
            "attrs": {
              "class": "webgis-custom-option",
              "style": "font-weight: bold;",
              "value": "#"
            },
            "props": {
              "selected": true
            },
            "children": [
              "Eigenes 1"
            ]
          },
          {
            "tag": "optgroup",
            "attrs": {
              "class": "webgis-custom-option",
              "label": "Kategorie"
            },
            "children": [
              {
                "tag": "option",
                "attrs": {
                  "class": "webgis-custom-option",
                  "value": "c2"
                },
                "props": {
                  "selected": false
                },
                "children": [
                  "Eigenes 2"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.on",
      "args": [
        "onaddservice",
        "[function]",
        "[element:select#combo.require-ui-refresh.webgis-query-combo.webgis-select]"
      ]
    },
    {
      "call": "map.events.on",
      "args": [
        "onremoveservice",
        "[function]",
        "[element:select#combo.require-ui-refresh.webgis-query-combo.webgis-select]"
      ]
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
