{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "select",
        "attrs": {
          "class": "custom-css webgis-dependencies webgis-dependency-hasselection webgis-select webgis-query-combo",
          "element-target": "default",
          "id": "combo",
          "style": "width:100px"
        },
        "props": {
          "value": "",
          "selectedIndex": -1
        },
        "expandos": {
          "_map": "[fake:map]",
          "_opt": {
            "customitems": null,
            "map": "[fake:map]",
            "onchange": null,
            "type": "query",
            "valuefunction": null
          }
        }
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.on",
      "args": [
        "onaddservice",
        "[function]",
        "[element:select#combo.custom-css.webgis-dependencies.webgis-dependency-hasselection.webgis-query-combo.webgis-select]"
      ]
    },
    {
      "call": "map.events.on",
      "args": [
        "onremoveservice",
        "[function]",
        "[element:select#combo.custom-css.webgis-dependencies.webgis-dependency-hasselection.webgis-query-combo.webgis-select]"
      ]
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
