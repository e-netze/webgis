{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-validation-holder"
        },
        "children": [
          {
            "tag": "span",
            "attrs": {
              "class": "webgis-autocomplete-wrapper",
              "style": "display: block;"
            },
            "children": [
              {
                "tag": "input",
                "attrs": {
                  "aria-autocomplete": "list",
                  "aria-controls": "webgis-autocomplete-menu-{guid}",
                  "aria-expanded": "false",
                  "autocomplete": "off",
                  "class": "webgis-input webgis-autocomplete webgis-validation webgis-not-valid",
                  "data-minlength": "1",
                  "element-target": "default",
                  "id": "elem",
                  "role": "combobox",
                  "spellcheck": "false",
                  "type": "text",
                  "webgis-validation-required": "true"
                },
                "props": {
                  "value": ""
                },
                "data": {
                  "__plugins__": [
                    "[object Ctor]",
                    "[object Ctor]"
                  ],
                  "errorMessageElement": "[jQuery(1):div.haserror.webgis-validation-error]",
                  "webgis_autocomplete": "[object Ctor]",
                  "webgis_validation": "[object Ctor]"
                },
                "events": {
                  "blur": 1,
                  "blur.webgis_autocomplete": 1,
                  "change": 1,
                  "focus": 1,
                  "focus.webgis_autocomplete": 1,
                  "input.webgis_autocomplete": 1,
                  "input.webgis_validation": 1,
                  "keydown.webgis_autocomplete": 1
                }
              },
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-autocomplete-menu",
                  "id": "webgis-autocomplete-menu-{guid}",
                  "role": "listbox"
                },
                "events": {
                  "click.webgis_autocomplete .webgis-autocomplete-suggestion": 1,
                  "mousedown.webgis_autocomplete": 1,
                  "mouseout.webgis_autocomplete": 1,
                  "mouseover.webgis_autocomplete .webgis-autocomplete-suggestion": 1
                }
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-validation-error haserror"
            },
            "children": [
              "Eingabe ist erforderlich"
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
