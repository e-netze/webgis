{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-ui-collapsable"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-title"
            },
            "events": {
              "click": 1
            },
            "children": [
              {
                "tag": "h2",
                "children": [
                  {
                    "tag": "img",
                    "attrs": {
                      "class": "collapse-arrow",
                      "src": "https://webgis.test/rest/imageresource/expanded-26~png?sub=ui&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}"
                    }
                  },
                  " Abschnitt"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-content",
              "style": "display: block;"
            },
            "children": [
              {
                "tag": "span",
                "attrs": {
                  "class": "webgis-autocomplete-wrapper",
                  "style": "display: block;"
                },
                "children": [
                  {
                    "tag": "input",
                    "attrs": {
                      "aria-autocomplete": "list",
                      "aria-controls": "webgis-autocomplete-menu-{guid}",
                      "aria-expanded": "false",
                      "autocomplete": "off",
                      "class": "webgis-input webgis-autocomplete",
                      "data-minlength": "2",
                      "element-target": "default",
                      "role": "combobox",
                      "spellcheck": "false",
                      "type": "text"
                    },
                    "props": {
                      "value": ""
                    },
                    "data": {
                      "__plugins__": [
                        "[object Ctor]"
                      ],
                      "webgis_autocomplete": "[object Ctor]"
                    },
                    "events": {
                      "blur": 1,
                      "blur.webgis_autocomplete": 1,
                      "focus": 1,
                      "focus.webgis_autocomplete": 1,
                      "input.webgis_autocomplete": 1,
                      "keydown.webgis_autocomplete": 1
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-autocomplete-menu",
                      "id": "webgis-autocomplete-menu-{guid}",
                      "role": "listbox"
                    },
                    "events": {
                      "click.webgis_autocomplete .webgis-autocomplete-suggestion": 1,
                      "mousedown.webgis_autocomplete": 1,
                      "mouseout.webgis_autocomplete": 1,
                      "mouseover.webgis_autocomplete .webgis-autocomplete-suggestion": 1
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
