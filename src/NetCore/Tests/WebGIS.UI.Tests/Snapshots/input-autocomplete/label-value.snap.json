{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "span",
        "attrs": {
          "class": "webgis-autocomplete-wrapper",
          "style": "display: block;"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "aria-autocomplete": "list",
              "aria-controls": "webgis-autocomplete-menu-{guid}",
              "aria-expanded": "false",
              "autocomplete": "off",
              "class": "webgis-input webgis-autocomplete",
              "data-minlength": "2",
              "data-value": "Daten 'Wert'",
              "element-target": "default",
              "role": "combobox",
              "spellcheck": "false",
              "type": "text",
              "value": "Daten 'Wert'"
            },
            "props": {
              "value": "Label-Wert"
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "webgis_autocomplete": "[object Ctor]"
            },
            "events": {
              "blur": 1,
              "blur.webgis_autocomplete": 1,
              "focus": 1,
              "focus.webgis_autocomplete": 1,
              "input.webgis_autocomplete": 1,
              "keydown.webgis_autocomplete": 1
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-autocomplete-menu",
              "id": "webgis-autocomplete-menu-{guid}",
              "role": "listbox"
            },
            "events": {
              "click.webgis_autocomplete .webgis-autocomplete-suggestion": 1,
              "mousedown.webgis_autocomplete": 1,
              "mouseout.webgis_autocomplete": 1,
              "mouseover.webgis_autocomplete .webgis-autocomplete-suggestion": 1
            }
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
