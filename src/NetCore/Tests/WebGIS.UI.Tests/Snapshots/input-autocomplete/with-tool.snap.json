{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    }
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-modal",
          "id": "webgis-modal-server-button-modal-dialog",
          "style": "z-index:9999;position:fixed;left:0px;right:0px;top:0px;bottom:0px;background:rgba(0,0,0,0.5);"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "webgis_modalDialog": "[object Ctor]"
        },
        "events": {
          "click.webgis_modalDialog": 1,
          "mousedown.webgis_modalDialog": 1
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-modal-body center animate",
              "id": "",
              "style": "z-index: 1000; position: absolute; width: 330px; height: 640px; min-width: 330px; max-width: 100%; background: var(--webgis-ui-surface); opacity: 1; display: block; left: 475px; top: 40px; max-height: calc(100% - 80px); min-height: 0px;"
            },
            "events": {
              "click.webgis_modalDialog": 1
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-modal-content",
                  "id": "webgis-modal-content",
                  "style": "z-index:1;position:absolute;overflow:auto;left:0px;top:calc(43px + var(--webgis-ui-border-width-item-selected));right:0px;bottom:0px"
                },
                "children": [
                  {
                    "tag": "span",
                    "attrs": {
                      "class": "twitter-typeahead",
                      "style": "position: relative; display: block;"
                    },
                    "events": {
                      "mouseout .tt-menu": 1,
                      "mouseover .tt-suggestion": 1
                    },
                    "children": [
                      {
                        "tag": "input",
                        "attrs": {
                          "autocomplete": "off",
                          "class": "webgis-input webgis-autocomplete tt-input",
                          "data-minlength": "2",
                          "data-source": "/__autocomplete/search?x=1",
                          "dir": "auto",
                          "element-target": "default",
                          "spellcheck": "false",
                          "style": "position: relative; vertical-align: top;",
                          "type": "text"
                        },
                        "props": {
                          "value": ""
                        },
                        "data": {
                          "ttAttrs": {
                            "autocomplete": "[undefined]",
                            "dir": "[undefined]",
                            "spellcheck": "[undefined]",
                            "style": "[undefined]"
                          },
                          "ttTypeahead": "[object c]",
                          "ttWww": {
                            "classes": {
                              "cursor": "tt-cursor",
                              "dataset": "tt-dataset",
                              "empty": "tt-empty",
                              "highlight": "tt-highlight",
                              "hint": "tt-hint",
                              "input": "tt-input",
                              "menu": "tt-menu",
                              "open": "tt-open",
                              "selectable": "tt-selectable",
                              "suggestion": "tt-suggestion",
                              "wrapper": "twitter-typeahead"
                            },
                            "css": {
                              "hint": {
                                "borderColor": "transparent",
                                "boxShadow": "none",
                                "left": "0",
                                "opacity": "1",
                                "position": "absolute",
                                "top": "0"
                              },
                              "input": {
                                "backgroundColor": "transparent",
                                "position": "relative",
                                "verticalAlign": "top"
                              },
                              "inputWithNoHint": {
                                "position": "relative",
                                "verticalAlign": "top"
                              },
                              "ltr": {
                                "left": "0",
                                "right": "auto"
                              },
                              "menu": {
                                "display": "none",
                                "left": "0",
                                "position": "absolute",
                                "top": "100%",
                                "zIndex": "100"
                              },
                              "rtl": {
                                "left": "auto",
                                "right": " 0"
                              },
                              "wrapper": {
                                "display": "inline-block",
                                "position": "relative"
                              }
                            },
                            "html": {
                              "menu": "<div class=\"tt-menu\"></div>",
                              "wrapper": "<span class=\"twitter-typeahead\"></span>"
                            },
                            "mixin": "[function]",
                            "selectors": {
                              "cursor": ".tt-cursor",
                              "dataset": ".tt-dataset",
                              "empty": ".tt-empty",
                              "highlight": ".tt-highlight",
                              "hint": ".tt-hint",
                              "input": ".tt-input",
                              "menu": ".tt-menu",
                              "open": ".tt-open",
                              "selectable": ".tt-selectable",
                              "suggestion": ".tt-suggestion",
                              "wrapper": ".twitter-typeahead"
                            }
                          }
                        },
                        "events": {
                          "blur": 1,
                          "blur.tt": 2,
                          "focus": 2,
                          "focus.tt": 1,
                          "input.tt": 1,
                          "keydown.tt": 1,
                          "keyup": 1,
                          "typeahead:cursorchange": 1,
                          "typeahead:open": 1,
                          "typeahead:select": 1
                        }
                      },
                      {
                        "tag": "pre",
                        "attrs": {
                          "aria-hidden": "true",
                          "style": "position: absolute; visibility: hidden; white-space: pre; font-family: Arial; font-size: 13.3333px; font-style: normal; font-variant: normal; font-weight: 400; word-spacing: 0px; letter-spacing: 0px; text-indent: 0px; text-rendering: auto; text-transform: none;"
                        }
                      },
                      {
                        "tag": "div",
                        "attrs": {
                          "class": "tt-menu",
                          "style": "position: absolute; top: 100%; left: 0px; z-index: 100; display: none;"
                        },
                        "events": {
                          "click.tt .tt-selectable": 1,
                          "mousedown.tt": 1
                        },
                        "children": [
                          {
                            "tag": "div",
                            "attrs": {
                              "class": "tt-dataset tt-dataset-0"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "style": "position: absolute; left: 0px; right: 0px; top: 0px; height: 35px; cursor: pointer;"
                },
                "events": {
                  "click.webgis_modalDialog": 1
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-title has-closebutton"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-resize"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-close"
                    },
                    "events": {
                      "click.webgis_modalDialog": 1
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "body": [],
  "calls": [
    {
      "call": "map.events.fire",
      "args": [
        "onbuildtoolui",
        "test-tool"
      ]
    },
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.advancedToolBehaviour",
      "args": []
    },
    {
      "call": "map.ui.webgisContainer",
      "args": []
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#webgis-modal-content.webgis-modal-content]",
          "target": "default"
        }
      ]
    }
  ]
}
