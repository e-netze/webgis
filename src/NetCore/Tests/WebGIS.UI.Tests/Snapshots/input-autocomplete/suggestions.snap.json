{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "span",
        "attrs": {
          "class": "webgis-autocomplete-wrapper",
          "style": "display: block;"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "aria-autocomplete": "list",
              "aria-controls": "webgis-autocomplete-menu-{guid}",
              "aria-expanded": "true",
              "autocomplete": "off",
              "class": "webgis-input webgis-autocomplete",
              "data-minlength": "2",
              "element-target": "default",
              "id": "elem",
              "role": "combobox",
              "spellcheck": "false",
              "type": "text"
            },
            "props": {
              "value": "Gra"
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "webgis_autocomplete": "[object Ctor]"
            },
            "events": {
              "blur": 1,
              "blur.webgis_autocomplete": 1,
              "focus": 1,
              "focus.webgis_autocomplete": 1,
              "input.webgis_autocomplete": 1,
              "keydown.webgis_autocomplete": 1
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-autocomplete-menu open",
              "id": "webgis-autocomplete-menu-{guid}",
              "role": "listbox",
              "style": "top: 29px; left: 8px; width: 177px; max-height: calc(100% - 109px);"
            },
            "events": {
              "click.webgis_autocomplete .webgis-autocomplete-suggestion": 1,
              "mousedown.webgis_autocomplete": 1,
              "mouseout.webgis_autocomplete": 1,
              "mouseover.webgis_autocomplete .webgis-autocomplete-suggestion": 1
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-autocomplete-suggestion webgis-autocomplete-content",
                  "data-index": "0",
                  "id": "webgis-autocomplete-menu-{guid}-0",
                  "role": "option",
                  "style": "text-align:left"
                },
                "data": {
                  "item": {
                    "id": "1",
                    "label": "Graz",
                    "value": "Graz"
                  }
                },
                "children": [
                  "Graz"
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-autocomplete-suggestion webgis-autocomplete-content",
                  "data-index": "1",
                  "id": "webgis-autocomplete-menu-{guid}-1",
                  "role": "option",
                  "style": "text-align:left"
                },
                "data": {
                  "item": {
                    "id": "2",
                    "label": "Gratkorn",
                    "value": "Gratkorn"
                  }
                },
                "children": [
                  "Gratkorn"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
