{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "select",
        "attrs": {
          "class": " webgis-select",
          "data-value": "s1~lab1",
          "element-target": "default",
          "id": "combo"
        },
        "props": {
          "value": "s1~lab1",
          "selectedIndex": 0
        },
        "expandos": {
          "0": "[element:option]",
          "_map": "[fake:map]",
          "_opt": {
            "map": "[fake:map]",
            "val": "s1~lab1"
          }
        },
        "children": [
          {
            "tag": "optgroup",
            "attrs": {
              "label": "Dienst 1"
            },
            "expandos": {
              "service": {
                "chainagethemes": [
                  {
                    "id": "c1",
                    "name": "Station 1"
                  }
                ],
                "checkLayerVisibility": "[fake:service.checkLayerVisibility]",
                "editthemes": [
                  {
                    "dbrights": "iud",
                    "layerid": "l1",
                    "name": "Thema 1",
                    "tags": "[max-depth]",
                    "themeid": "t1"
                  },
                  {
                    "dbrights": "i",
                    "layerid": "l2",
                    "name": "Thema 2",
                    "themeid": "t2"
                  }
                ],
                "getLayer": "[function]",
                "id": "s1",
                "labeling": [
                  {
                    "id": "lab1",
                    "name": "Beschriftung 1"
                  }
                ],
                "layerVisibleAndInScale": "[function]",
                "map": "[fake:map]",
                "name": "Dienst 1",
                "queries": [
                  {
                    "id": "q1",
                    "items": "[max-depth]",
                    "layerid": "l1",
                    "name": "Abfrage 1"
                  },
                  {
                    "id": "q2",
                    "items": "[max-depth]",
                    "name": "Unsichtbar",
                    "visible": false
                  },
                  {
                    "id": "q3",
                    "items": "[max-depth]",
                    "name": "Ohne Items"
                  }
                ],
                "serviceInfo": {
                  "id": "s1",
                  "name": "Dienst 1"
                },
                "setLayerVisibility": "[fake:service.setLayerVisibility]"
              }
            },
            "children": [
              {
                "tag": "option",
                "attrs": {
                  "style": "background-image: url(\"https://webgis.test/content/api/img/check2-24.png\"); background-position: 0px -2px; background-repeat: no-repeat; height: 24px;",
                  "value": "s1~lab1"
                },
                "props": {
                  "selected": true
                },
                "children": [
                  " Beschriftung 1"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.hasLabeling",
      "args": [
        "s1~lab1"
      ]
    },
    {
      "call": "map.events.on",
      "args": [
        "onaddservice",
        "[function]",
        "[element:select#combo.webgis-select]"
      ]
    },
    {
      "call": "map.events.on",
      "args": [
        "onremoveservice",
        "[function]",
        "[element:select#combo.webgis-select]"
      ]
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
