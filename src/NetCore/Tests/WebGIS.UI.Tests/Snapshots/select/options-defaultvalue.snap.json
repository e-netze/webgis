{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "select",
        "attrs": {
          "class": " webgis-select",
          "element-target": "default",
          "id": "combo"
        },
        "props": {
          "value": "b",
          "selectedIndex": 1
        },
        "expandos": {
          "0": "[element:option]",
          "1": "[element:option]",
          "2": "[element:option]"
        },
        "children": [
          {
            "tag": "option",
            "attrs": {
              "value": "a"
            },
            "props": {
              "selected": false
            },
            "children": [
              "Option A"
            ]
          },
          {
            "tag": "option",
            "attrs": {
              "selected": "selected",
              "value": "b"
            },
            "props": {
              "selected": true
            },
            "children": [
              "Option B"
            ]
          },
          {
            "tag": "option",
            "attrs": {
              "value": "c"
            },
            "props": {
              "selected": false
            },
            "children": [
              "Option C"
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
