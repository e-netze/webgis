{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "select",
        "attrs": {
          "class": "webgis-select webgis-select-has-dependency-field-ids",
          "element-target": "default",
          "id": "combo"
        },
        "props": {
          "value": "a",
          "selectedIndex": 0
        },
        "data": {
          "dependencyFieldIds": [
            "f1",
            "f2"
          ],
          "dependency_field_ids_callback_toolid": "callback-tool"
        },
        "events": {
          "change": 1
        },
        "expandos": {
          "0": "[element:option]",
          "1": "[element:option]",
          "2": "[element:option]",
          "map": "[fake:map]",
          "refillSelect": "[function]"
        },
        "children": [
          {
            "tag": "option",
            "attrs": {
              "value": "a"
            },
            "props": {
              "selected": true
            },
            "children": [
              "Option A"
            ]
          },
          {
            "tag": "option",
            "attrs": {
              "value": "b"
            },
            "props": {
              "selected": false
            },
            "children": [
              "Option B"
            ]
          },
          {
            "tag": "option",
            "attrs": {
              "value": "c"
            },
            "props": {
              "selected": false
            },
            "children": [
              "Option C"
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    },
    {
      "call": "webgis.tools.onButtonClick",
      "args": [
        "[fake:map]",
        {
          "command": "_event_handler_onupdatecombo",
          "id": "callback-tool",
          "map": "[fake:map]",
          "type": "servertoolcommand_ext"
        },
        "[undefined]",
        null,
        {
          "combo-id": "combo"
        }
      ]
    }
  ]
}
