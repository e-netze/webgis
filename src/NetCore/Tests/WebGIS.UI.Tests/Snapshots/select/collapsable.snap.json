{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-ui-collapsable"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-title"
            },
            "events": {
              "click": 1
            },
            "children": [
              {
                "tag": "h2",
                "children": [
                  {
                    "tag": "img",
                    "attrs": {
                      "class": "collapse-arrow",
                      "src": "https://webgis.test/rest/imageresource/collapsed-26~png?sub=ui&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}"
                    }
                  },
                  " Auswahl"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-content",
              "style": "display: none;"
            },
            "children": [
              {
                "tag": "select",
                "attrs": {
                  "class": " webgis-select",
                  "element-target": "default",
                  "id": "combo"
                },
                "props": {
                  "value": "c",
                  "selectedIndex": 2
                },
                "expandos": {
                  "0": "[element:option]",
                  "1": "[element:option]",
                  "2": "[element:option]"
                },
                "children": [
                  {
                    "tag": "option",
                    "attrs": {
                      "value": "a"
                    },
                    "props": {
                      "selected": false
                    },
                    "children": [
                      "Option A"
                    ]
                  },
                  {
                    "tag": "option",
                    "attrs": {
                      "value": "b"
                    },
                    "props": {
                      "selected": false
                    },
                    "children": [
                      "Option B"
                    ]
                  },
                  {
                    "tag": "option",
                    "attrs": {
                      "selected": "selected",
                      "value": "c"
                    },
                    "props": {
                      "selected": true
                    },
                    "children": [
                      "Option C"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
