{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "select",
        "attrs": {
          "class": "webgis-select webgis-validation validated-parameter",
          "element-target": "default",
          "id": "combo",
          "webgis-validation-required": "true"
        },
        "props": {
          "value": "a",
          "selectedIndex": 0
        },
        "data": {
          "errorMessageElement": "[jQuery(1):div.webgis-validation-error]"
        },
        "events": {
          "change": 1,
          "input": 1
        },
        "expandos": {
          "0": "[element:option]",
          "1": "[element:option]",
          "2": "[element:option]"
        },
        "children": [
          {
            "tag": "option",
            "attrs": {
              "value": "a"
            },
            "props": {
              "selected": true
            },
            "children": [
              "Option A"
            ]
          },
          {
            "tag": "option",
            "attrs": {
              "value": "b"
            },
            "props": {
              "selected": false
            },
            "children": [
              "Option B"
            ]
          },
          {
            "tag": "option",
            "attrs": {
              "value": "c"
            },
            "props": {
              "selected": false
            },
            "children": [
              "Option C"
            ]
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-validation-error"
        }
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
