{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "button",
        "attrs": {
          "class": "webgis-button",
          "element-target": "default",
          "id": "upload"
        },
        "events": {
          "click": 1
        },
        "children": [
          "Datei hochladen"
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "style": "display: none;"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "id": "upload_file_input",
              "name": "upload",
              "type": "file"
            },
            "props": {
              "value": "C:\\fakepath\\test.txt"
            },
            "data": {
              "map": "[fake:map]",
              "servercommand": "upload-cmd",
              "toolid": "webgis.ui.tests.uibuilder.uploadelementstests"
            },
            "events": {
              "change": 1
            }
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "webgis.tools.uploadFile",
      "args": [
        "[fake:map]",
        "webgis.ui.tests.uibuilder.uploadelementstests",
        "upload-cmd",
        "upload",
        "[object File]"
      ]
    }
  ]
}
