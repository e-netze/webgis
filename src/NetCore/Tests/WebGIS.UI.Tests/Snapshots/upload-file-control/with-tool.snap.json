{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    }
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-modal",
          "id": "webgis-modal-server-button-modal-dialog",
          "style": "z-index:9999;position:fixed;left:0px;right:0px;top:0px;bottom:0px;background:rgba(0,0,0,0.5);"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "webgis_modalDialog": "[object Ctor]"
        },
        "events": {
          "click.webgis_modalDialog": 1,
          "mousedown.webgis_modalDialog": 1
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-modal-body center animate",
              "id": "",
              "style": "z-index: 1000; position: absolute; width: 330px; height: 640px; min-width: 330px; max-width: 100%; background: var(--webgis-ui-surface); opacity: 1; display: block; left: 475px; top: 40px; max-height: calc(100% - 80px); min-height: 0px;"
            },
            "events": {
              "click.webgis_modalDialog": 1
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-modal-content",
                  "id": "webgis-modal-content",
                  "style": "z-index:1;position:absolute;overflow:auto;left:0px;top:calc(43px + var(--webgis-ui-border-width-item-selected));right:0px;bottom:0px"
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-control-upload",
                      "element-target": "default"
                    },
                    "data": {
                      "__plugins__": [
                        "[object Ctor]"
                      ],
                      "webgis_control_upload": "[object Ctor]"
                    },
                    "children": [
                      {
                        "tag": "input",
                        "attrs": {
                          "id": "editfield_FOTO",
                          "name": "editfield_FOTO",
                          "type": "hidden"
                        },
                        "props": {
                          "value": ""
                        }
                      },
                      {
                        "tag": "div",
                        "attrs": {
                          "class": "webgis-input",
                          "data-fileinput-id": "FOTO-target-{guid}-{guid}",
                          "data-name": "FOTO",
                          "id": "FOTO-target-{guid}-preview",
                          "style": "cursor:pointer;width:288px;position:relative;height:22px;display:block"
                        },
                        "data": {
                          "onUpload": null
                        },
                        "events": {
                          "click.webgis_control_upload": 1
                        },
                        "children": [
                          {
                            "tag": "div",
                            "attrs": {
                              "style": "position:absolute;right:2px;bottom:2px;width:26px;height:26px;background:url(https://webgis.test/content/api/img/upload-26.png) no-repeat center right;"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "style": "position: absolute; left: 0px; right: 0px; top: 0px; height: 35px; cursor: pointer;"
                },
                "events": {
                  "click.webgis_modalDialog": 1
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-title has-closebutton"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-resize"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-close"
                    },
                    "events": {
                      "click.webgis_modalDialog": 1
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "body": [
    {
      "tag": "div",
      "attrs": {
        "id": "__webgis-upload-div-container",
        "style": "display:none"
      },
      "children": [
        {
          "tag": "div",
          "attrs": {
            "id": "FOTO-target-{guid}-upload-div"
          },
          "children": [
            {
              "tag": "iframe",
              "attrs": {
                "id": "FOTO-target-{guid}-frame",
                "name": "FOTO-target-{guid}-frame",
                "style": "display:none"
              }
            },
            {
              "tag": "form",
              "attrs": {
                "action": "",
                "enctype": "multipart/form-data",
                "method": "post",
                "target": "FOTO-target-{guid}-frame"
              },
              "expandos": {
                "0": "[element:input#FOTO-target-{guid}-{guid}]"
              },
              "children": [
                {
                  "tag": "input",
                  "attrs": {
                    "data-name": "FOTO",
                    "data-service": "edit-service",
                    "data-theme": "edit-theme",
                    "id": "FOTO-target-{guid}-{guid}",
                    "name": "file",
                    "type": "file"
                  },
                  "props": {
                    "value": ""
                  },
                  "events": {
                    "change.webgis_control_upload": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "calls": [
    {
      "call": "map.events.fire",
      "args": [
        "onbuildtoolui",
        "test-tool"
      ]
    },
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.advancedToolBehaviour",
      "args": []
    },
    {
      "call": "map.ui.webgisContainer",
      "args": []
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#webgis-modal-content.webgis-modal-content]",
          "target": "default"
        }
      ]
    }
  ]
}
