{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-click-toggle",
          "element-target": "default",
          "id": "t1"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "options": {
            "resetSiblings": false,
            "toggleStyle": [
              "background-color",
              "color"
            ],
            "toggleStyleValue": [
              "red",
              "white"
            ]
          },
          "webgis_clickToggle": "[object Ctor]"
        },
        "events": {
          "click.webgis_click_toggle": 1
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-label",
              "element-target": "default"
            },
            "children": [
              "t1"
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
