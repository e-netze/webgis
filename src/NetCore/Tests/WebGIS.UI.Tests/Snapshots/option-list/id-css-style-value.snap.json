{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-ui-option-list-holder"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "class": "custom-css webgis-ui-option-list-value",
              "data-value": "v1",
              "id": "list",
              "style": "width:100px",
              "type": "hidden",
              "value": "a"
            },
            "props": {
              "value": "a"
            }
          },
          {
            "tag": "ul",
            "attrs": {
              "class": "webgis-ui-option-list",
              "element-target": "default"
            },
            "children": [
              {
                "tag": "li",
                "attrs": {
                  "class": "webgis-ui-option-list-item selected",
                  "element-target": "default"
                },
                "data": {
                  "value": "a"
                },
                "events": {
                  "click": 1
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-label",
                      "element-target": "default"
                    },
                    "children": [
                      "Option a"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
