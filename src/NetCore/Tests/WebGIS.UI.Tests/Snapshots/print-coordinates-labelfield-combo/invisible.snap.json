{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "children": [
          {
            "tag": "input",
            "attrs": {
              "id": "combo",
              "type": "hidden"
            },
            "props": {
              "value": ""
            }
          },
          {
            "tag": "select",
            "attrs": {
              "class": " webgis-select",
              "element-target": "default",
              "style": "display:none"
            },
            "props": {
              "value": "",
              "selectedIndex": 0
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "webgis_multi_select": "[object Ctor]"
            },
            "events": {
              "change.webgis_multi_select": 1
            },
            "expandos": {
              "0": "[element:option]"
            },
            "children": [
              {
                "tag": "option",
                "attrs": {
                  "value": ""
                },
                "props": {
                  "selected": true
                },
                "children": [
                  "--- Beschriftung (optional) ---"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-multiselect-container"
            }
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.queryResultFeatures.firstToolResult",
      "args": [
        "webgis.tools.coordinates"
      ]
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
