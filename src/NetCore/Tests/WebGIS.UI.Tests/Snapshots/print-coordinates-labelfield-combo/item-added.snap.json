{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "children": [
          {
            "tag": "input",
            "attrs": {
              "id": "combo",
              "type": "hidden",
              "value": "RW_HW"
            },
            "props": {
              "value": "RW_HW"
            }
          },
          {
            "tag": "select",
            "attrs": {
              "class": " webgis-select",
              "element-target": "default"
            },
            "props": {
              "value": "",
              "selectedIndex": 0
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "webgis_multi_select": "[object Ctor]"
            },
            "events": {
              "change.webgis_multi_select": 1
            },
            "expandos": {
              "0": "[element:option]",
              "1": "[element:option]",
              "2": "[element:option]",
              "3": "[element:option]",
              "4": "[element:option]",
              "5": "[element:option]"
            },
            "children": [
              {
                "tag": "option",
                "attrs": {
                  "value": ""
                },
                "props": {
                  "selected": true
                },
                "children": [
                  "--- Beschriftung (optional) ---"
                ]
              },
              {
                "tag": "option",
                "attrs": {
                  "value": "RW_HW"
                },
                "props": {
                  "selected": false
                },
                "children": [
                  "RW_HW"
                ]
              },
              {
                "tag": "option",
                "attrs": {
                  "value": "NUR_RW"
                },
                "props": {
                  "selected": false
                },
                "children": [
                  "NUR_RW"
                ]
              },
              {
                "tag": "option",
                "attrs": {
                  "value": "DREI"
                },
                "props": {
                  "selected": false
                },
                "children": [
                  "DREI"
                ]
              },
              {
                "tag": "option",
                "attrs": {
                  "value": "TEXT"
                },
                "props": {
                  "selected": false
                },
                "children": [
                  "TEXT"
                ]
              },
              {
                "tag": "option",
                "attrs": {
                  "value": "_label"
                },
                "props": {
                  "selected": false
                },
                "children": [
                  "Beschriftung"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-multiselect-container"
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-multiselect-continer-item"
                },
                "data": {
                  "value": "RW_HW"
                },
                "children": [
                  "RW_HW",
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "remove"
                    },
                    "events": {
                      "click.webgis_multi_select": 1
                    },
                    "children": [
                      "X"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.queryResultFeatures.firstToolResult",
      "args": [
        "webgis.tools.coordinates"
      ]
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
