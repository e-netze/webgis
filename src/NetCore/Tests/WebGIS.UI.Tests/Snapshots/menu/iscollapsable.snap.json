{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-ui-collapsable"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-title"
            },
            "events": {
              "click": 1
            },
            "children": [
              {
                "tag": "h2",
                "children": [
                  {
                    "tag": "img",
                    "attrs": {
                      "class": "collapse-arrow",
                      "src": "https://webgis.test/rest/imageresource/collapsed-26~png?sub=ui&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}"
                    }
                  },
                  " Abschnitt"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-content",
              "style": "display: none;"
            },
            "children": [
              {
                "tag": "ul",
                "attrs": {
                  "class": "webgis-toolbox-tool-item-group-details",
                  "element-target": "default",
                  "style": "list-style:none;padding:0px;"
                },
                "children": [
                  {
                    "tag": "li",
                    "attrs": {
                      "class": "webgis-toolbox-tool-item",
                      "element-target": "default",
                      "id": "i1",
                      "style": "padding: 12px 4px 12px 32px; background-image: url(\"https://webgis.test/rest/imageresource/enter-26~png?sub=ui&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); background-position: 2px 10px; background-size: auto 26px; background-repeat: no-repeat;"
                    },
                    "children": [
                      {
                        "tag": "div",
                        "children": [
                          "Eintrag"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
