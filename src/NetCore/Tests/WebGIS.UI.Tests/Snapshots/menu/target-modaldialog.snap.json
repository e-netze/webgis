{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    }
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-modal",
          "id": "webgis-modal-modaldialog",
          "style": "z-index:9999;position:fixed;left:0px;right:0px;top:0px;bottom:0px;background:rgba(0,0,0,0.5);"
        },
        "data": {
          "__plugins__": [
            "[object Ctor]"
          ],
          "webgis_modalDialog": "[object Ctor]"
        },
        "events": {
          "click.webgis_modalDialog": 1,
          "mousedown.webgis_modalDialog": 1
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-modal-body center animate",
              "id": "",
              "style": "z-index: 1000; position: absolute; width: 330px; min-width: 330px; max-width: 100%; background: var(--webgis-ui-surface); opacity: 1; display: block; left: 475px; top: 200px; max-height: calc(100% - 200px); height: 134px; min-height: 0px;"
            },
            "events": {
              "click.webgis_modalDialog": 1
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-modal-content",
                  "id": "webgis-modal-content",
                  "style": "z-index:1;position:absolute;overflow:auto;left:0px;top:calc(43px + var(--webgis-ui-border-width-item-selected));right:0px;bottom:0px"
                },
                "children": [
                  {
                    "tag": "ul",
                    "attrs": {
                      "class": "webgis-toolbox-tool-item-group-details",
                      "element-target": "modaldialog",
                      "style": "list-style:none;padding:0px;"
                    },
                    "children": [
                      {
                        "tag": "li",
                        "attrs": {
                          "class": "webgis-toolbox-tool-item",
                          "element-target": "default",
                          "id": "i1",
                          "style": "padding: 12px 4px 12px 32px; background-image: url(\"https://webgis.test/rest/imageresource/enter-26~png?sub=ui&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}\"); background-position: 2px 10px; background-size: auto 26px; background-repeat: no-repeat;"
                        },
                        "data": {
                          "_callback": {
                            "command": "cmd",
                            "tool": {
                              "id": "callback-tool",
                              "tooltype": "servertool"
                            },
                            "type": "servertoolcommand"
                          },
                          "_event": null,
                          "_map": "[fake:map]",
                          "_type": "menuitem"
                        },
                        "events": {
                          "click": 1
                        },
                        "children": [
                          {
                            "tag": "div",
                            "children": [
                              "Eintrag"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "style": "position: absolute; left: 0px; right: 0px; top: 0px; height: 35px; cursor: pointer;"
                },
                "events": {
                  "click.webgis_modalDialog": 1
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-title has-closebutton"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-resize"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-modal-close"
                    },
                    "events": {
                      "click.webgis_modalDialog": 1
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-modaldialog"
      ]
    },
    {
      "call": "map.ui.webgisContainer",
      "args": []
    },
    {
      "call": "map.getTool",
      "args": [
        "callback-tool"
      ]
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#webgis-modal-content.webgis-modal-content]",
          "target": "modaldialog"
        }
      ]
    }
  ]
}
