{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-liveshare-container",
          "element-target": "default",
          "id": "elem"
        },
        "children": [
          {
            "tag": "ul",
            "attrs": {
              "class": "liveshare-users"
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-input-group"
            },
            "children": [
              {
                "tag": "input",
                "attrs": {
                  "id": "liveshare-share-mapextent",
                  "type": "checkbox"
                },
                "props": {
                  "value": "on",
                  "checked": true
                },
                "events": {
                  "click": 2
                }
              },
              {
                "tag": "label",
                "attrs": {
                  "class": "webgis-input-label",
                  "for": "liveshare-share-mapextent"
                },
                "children": [
                  "Kartenauschnitt teilen"
                ]
              },
              {
                "tag": "div"
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-input-group"
            },
            "children": [
              {
                "tag": "input",
                "attrs": {
                  "id": "liveshare-share-layervisibility",
                  "type": "checkbox"
                },
                "props": {
                  "value": "on",
                  "checked": true
                },
                "events": {
                  "click": 2
                }
              },
              {
                "tag": "label",
                "attrs": {
                  "class": "webgis-input-label",
                  "for": "liveshare-share-layervisibility"
                },
                "children": [
                  "Themenschaltung teilen"
                ]
              }
            ]
          },
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-input",
              "placeholder": "Kurznachricht..."
            },
            "props": {
              "value": ""
            },
            "events": {
              "keypress": 1
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-liveshare-messages"
            }
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
