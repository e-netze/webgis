{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-validation-holder"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-input webgis-validation webgis-not-valid",
              "element-target": "default",
              "id": "elem",
              "type": "text",
              "webgis-validation-minlen": "3",
              "webgis-validation-regex": "^[a-z]+$",
              "webgis-validation-required": "true"
            },
            "props": {
              "value": ""
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "errorMessageElement": "[jQuery(1):div.haserror.webgis-validation-error]",
              "webgis_validation": "[object Ctor]"
            },
            "events": {
              "change": 1,
              "input.webgis_validation": 1
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-validation-error haserror"
            },
            "children": [
              "Eingabe ist erforderlich"
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
