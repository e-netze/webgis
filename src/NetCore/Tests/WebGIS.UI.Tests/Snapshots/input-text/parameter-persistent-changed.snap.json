{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "input",
        "attrs": {
          "class": "webgis-tool-parameter-persistent webgis-input",
          "element-target": "default",
          "id": "elem",
          "type": "text"
        },
        "props": {
          "value": "Neu"
        },
        "events": {
          "change": 1
        },
        "expandos": {
          "map": "[fake:map]"
        }
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.setPersistentToolParameter",
      "args": [
        {
          "id": "active-tool",
          "type": "clientbutton"
        },
        "elem",
        "Neu"
      ]
    }
  ]
}
