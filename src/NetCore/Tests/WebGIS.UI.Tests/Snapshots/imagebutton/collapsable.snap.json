{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-ui-collapsable"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-title"
            },
            "events": {
              "click": 1
            },
            "children": [
              {
                "tag": "h2",
                "children": [
                  {
                    "tag": "img",
                    "attrs": {
                      "class": "collapse-arrow",
                      "src": "https://webgis.test/rest/imageresource/expanded-26~png?sub=ui&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}"
                    }
                  },
                  " Abschnitt"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-content",
              "style": "display: block;"
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-ui-imagebutton",
                  "element-target": "default",
                  "style": "background-image: url(\"https://webgis.test/ui/edit-26.png\");",
                  "title": "Bearbeiten"
                },
                "events": {
                  "click": 1
                },
                "expandos": {
                  "buttoncommand": "edit",
                  "buttoncommand_argument": "[undefined]",
                  "buttontype": "servertoolcommand",
                  "map": "[fake:map]"
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-ui-imagebutton-text"
                    },
                    "children": [
                      "Bearbeiten"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
