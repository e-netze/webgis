{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-ui-collapsable"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-title"
            },
            "events": {
              "click": 1
            },
            "children": [
              {
                "tag": "h2",
                "children": [
                  {
                    "tag": "img",
                    "attrs": {
                      "class": "collapse-arrow",
                      "src": "https://webgis.test/rest/imageresource/expanded-26~png?sub=ui&company=undefined&colorscheme=default&v={{currentJavascriptVersion}}"
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-ui-selected-option",
                      "style": "display:inline-block;height:28px;overflow:hidden"
                    },
                    "children": [
                      {
                        "tag": "div",
                        "attrs": {
                          "class": "webgis-ui-imagebutton",
                          "data-value": "a",
                          "element-target": "default",
                          "id": "opt-a",
                          "style": "background-image: url(\"https://webgis.test/ui/a-26.png\"); min-height: 0px; height: 24px; background-position: center center; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;",
                          "title": "A"
                        },
                        "children": [
                          {
                            "tag": "div",
                            "attrs": {
                              "class": "webgis-ui-imagebutton-text"
                            },
                            "children": [
                              "A"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  " Optionen"
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-ui-collapsable-content",
              "style": "display: block;"
            },
            "children": [
              {
                "tag": "div",
                "attrs": {
                  "class": "webgis-ui-optionscontainer",
                  "element-target": "default",
                  "id": "options"
                },
                "expandos": {
                  "setValue": "[function]",
                  "value": "a"
                },
                "children": [
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-ui-imagebutton webgis-ui-option-selected",
                      "data-value": "a",
                      "element-target": "default",
                      "id": "opt-a",
                      "style": "background-image: url(\"https://webgis.test/ui/a-26.png\");",
                      "title": "A"
                    },
                    "data": {
                      "_value": "a"
                    },
                    "events": {
                      "click": 1
                    },
                    "expandos": {
                      "buttoncommand": "option",
                      "buttoncommand_argument": "[undefined]",
                      "buttontype": "clientbutton",
                      "map": "[fake:map]"
                    },
                    "children": [
                      {
                        "tag": "div",
                        "attrs": {
                          "class": "webgis-ui-imagebutton-text"
                        },
                        "children": [
                          "A"
                        ]
                      }
                    ]
                  },
                  {
                    "tag": "div",
                    "attrs": {
                      "class": "webgis-ui-imagebutton",
                      "data-value": "b",
                      "element-target": "default",
                      "id": "opt-b",
                      "style": "background-image: url(\"https://webgis.test/ui/b-26.png\");",
                      "title": "B"
                    },
                    "data": {
                      "_value": "b"
                    },
                    "events": {
                      "click": 1
                    },
                    "expandos": {
                      "buttoncommand": "option",
                      "buttoncommand_argument": "[undefined]",
                      "buttontype": "clientbutton",
                      "map": "[fake:map]"
                    },
                    "children": [
                      {
                        "tag": "div",
                        "attrs": {
                          "class": "webgis-ui-imagebutton-text"
                        },
                        "children": [
                          "B"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "webgis.tools.onButtonClick",
      "args": [
        "[fake:map]",
        {
          "argument": "[undefined]",
          "command": "option",
          "id": "opt-a",
          "map": "[fake:map]",
          "type": "clientbutton",
          "value": "a"
        },
        "[element:div#opt-a.webgis-ui-imagebutton.webgis-ui-option-selected]"
      ]
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
