{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "webgis-validation-container",
          "element-target": "default"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "class": "webgis-input webgis-validation webgis-not-valid",
              "data-value": "ab",
              "element-target": "default",
              "id": "required-input",
              "type": "text",
              "value": "ab",
              "webgis-validation-minlen": "3",
              "webgis-validation-required": "true"
            },
            "props": {
              "value": "ab"
            },
            "data": {
              "__plugins__": [
                "[object Ctor]"
              ],
              "errorMessageElement": "[jQuery(1):div.haserror.webgis-validation-error]",
              "webgis_validation": "[object Ctor]"
            },
            "events": {
              "change": 1,
              "input.webgis_validation": 1
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "webgis-validation-error haserror"
            },
            "children": [
              "Eingabe muss mindestens 3 Zeichen lang sein"
            ]
          },
          {
            "tag": "button",
            "attrs": {
              "class": "uibutton-validate-input webgis-button uibutton",
              "element-target": "default",
              "id": "btn"
            },
            "events": {
              "click": 1
            },
            "expandos": {
              "buttoncommand": "save",
              "buttoncommand_argument": "[undefined]",
              "buttontype": "servertoolcommand",
              "map": "[fake:map]"
            },
            "children": [
              "Speichern"
            ]
          }
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "webgis.alert",
      "args": [
        "Bitte geben Sie alle erfordlichen Werte ein!",
        "Eingabevalidierung"
      ]
    }
  ]
}
