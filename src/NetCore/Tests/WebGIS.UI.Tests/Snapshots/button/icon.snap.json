{
  "host": {
    "tag": "div",
    "attrs": {
      "class": "webgis-ui-holder",
      "id": "host"
    },
    "children": [
      {
        "tag": "button",
        "attrs": {
          "class": "webgis-button uibutton",
          "element-target": "default",
          "style": "background-image: url(\"https://webgis.test/ui/zoom-in-26.png\");"
        },
        "events": {
          "click": 1
        },
        "expandos": {
          "buttoncommand": "zoomin",
          "buttoncommand_argument": "[undefined]",
          "buttontype": "clientbutton",
          "map": "[fake:map]"
        },
        "children": [
          "Zoom"
        ]
      }
    ]
  },
  "container": {
    "tag": "div",
    "attrs": {
      "id": "webgis-container"
    }
  },
  "body": [],
  "calls": [
    {
      "call": "map.getActiveTool",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "onbuildui-default"
      ]
    },
    {
      "call": "map.ui.uncollapseSidebar",
      "args": []
    },
    {
      "call": "map.events.fire",
      "args": [
        "ui-builder-targetelement-changed",
        "[fake:map]",
        {
          "element": "[jQuery(1):div#host.webgis-ui-holder]",
          "target": "default"
        }
      ]
    }
  ]
}
